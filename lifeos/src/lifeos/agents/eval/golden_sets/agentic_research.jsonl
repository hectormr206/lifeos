// agentic_research golden set v2 — model_audit.py agentic role.
// Multi-round agentic research mirroring axi.briefing.run_agentic_briefing:
// the harness drives a REAL tool loop with the PRODUCTION system prompt
// (briefing.build_briefing_system + brain's tool-instructions suffix), the
// PRODUCTION tool schemas (axi.web_tools), canned handlers returning the
// production JSON shapes ({ok, query, results} / {ok, url, text, links}),
// max 5 tool rounds, then forced synthesis with briefing._FINAL_SYNTHESIS_PROMPT.
// The final answer is the production JSON contract {title, summary, items}
// (markdown is DERIVED by parse_briefing_result in prod, never requested).
// Schema:
//   canned_tools.web_search: flat {query_must_mention, results} OR keyed
//     {query_must_mention, queries: [{match_any, results}], default_results}
//     (first match_any hit wins; no hit -> default_results, usually []).
//   canned_tools.web_fetch: {url: page_text | {text, links: [{text, url}]}}.
//   expected: {must_call_tools, tools_required? (default true; false = tool-
//     optional case scored on facts/JSON only), final_json_keys,
//     facts_must_appear, facts_must_not_appear? (planted distractors that
//     must be ABSENT from the final answer)}.
// Case variety: search-only (news/clima/modelos), fetch-only, parallel
// search+fetch, chained search->fetch, multi-topic (2 searches), reformulated
// retry (first query returns nothing), distractor selection (search + fetch),
// links citation, and one tool-optional case.
{"id": "ag-news-01", "prompt": "Tráeme las 3 noticias de tecnología más importantes de hoy.", "canned_tools": {"web_search": {"query_must_mention": ["tecnolog"], "results": [{"title": "Quantum Photonics raises funding round", "url": "https://technews.example/quantum-photonics", "snippet": "La startup Quantum Photonics recaudó 850 millones de dólares para fabricar chips fotónicos en Monterrey."}, {"title": "Loihi 4 announced", "url": "https://technews.example/loihi-4", "snippet": "Intel presentó el chip neuromórfico Loihi 4 con eficiencia 12x frente a su antecesor."}, {"title": "Firefox releases privacy mode", "url": "https://technews.example/firefox", "snippet": "Firefox lanzó un modo de privacidad total que bloquea rastreadores de IA por defecto."}]}, "web_fetch": {}}, "expected": {"must_call_tools": ["web_search"], "final_json_keys": ["title", "summary", "items"], "facts_must_appear": ["quantum photonics", "850", "loihi"]}}
{"id": "ag-fetch-01", "prompt": "Resúmeme la portada de https://noticias-mx.example/portada en un boletín breve.", "canned_tools": {"web_search": {"query_must_mention": [], "results": []}, "web_fetch": {"https://noticias-mx.example/portada": "PORTADA — Noticias MX. Titular principal: El peso mexicano cierra en 16.8 por dólar, su mejor nivel del semestre. Segundo titular: El nuevo tren El Insurgente amplía su horario nocturno a partir del lunes. Tercero: La UNAM abre la convocatoria de becas de posgrado 2027."}}, "expected": {"must_call_tools": ["web_fetch"], "final_json_keys": ["title", "summary", "items"], "facts_must_appear": ["16.8", "insurgente"]}}
{"id": "ag-clima-01", "prompt": "Prepárame el pronóstico del clima de mañana para la Ciudad de México.", "canned_tools": {"web_search": {"query_must_mention": ["clima"], "results": [{"title": "Pronóstico CDMX", "url": "https://clima.example/cdmx", "snippet": "Mañana en la Ciudad de México: máxima de 24 grados, mínima de 13, probabilidad de lluvia del 70 por ciento por la tarde."}]}, "web_fetch": {}}, "expected": {"must_call_tools": ["web_search"], "final_json_keys": ["title", "summary", "items"], "facts_must_appear": ["24", "70"]}}
{"id": "ag-multi-01", "prompt": "Búscame las novedades de asistentes locales de IA y además lee https://lifeos.example/blog para el detalle de la última entrada.", "canned_tools": {"web_search": {"query_must_mention": ["asistente"], "results": [{"title": "Local AI assistants trend", "url": "https://ai-news.example/local-assistants", "snippet": "Los asistentes locales crecen: el proyecto OpenHome superó 40000 instalaciones este mes."}]}, "web_fetch": {"https://lifeos.example/blog": "Blog de LifeOS — última entrada: Axi ahora corre visión en la GPU integrada con gemma4-e2b y clasifica postura en menos de 2 segundos por cuadro."}}, "expected": {"must_call_tools": ["web_search", "web_fetch"], "final_json_keys": ["title", "summary", "items"], "facts_must_appear": ["openhome", "gemma4"]}}
{"id": "ag-modelos-01", "prompt": "Ármame un resumen de los lanzamientos de modelos de IA de esta semana.", "canned_tools": {"web_search": {"query_must_mention": ["modelos"], "results": [{"title": "Mistral Large 3 released", "url": "https://ai-news.example/mistral-large-3", "snippet": "Mistral publicó Mistral Large 3 con una ventana de contexto de 2 millones de tokens y pesos abiertos."}, {"title": "Qwen4 preview", "url": "https://ai-news.example/qwen4", "snippet": "Alibaba mostró un adelanto de Qwen4 enfocado en razonamiento con herramientas."}]}, "web_fetch": {}}, "expected": {"must_call_tools": ["web_search"], "final_json_keys": ["title", "summary", "items"], "facts_must_appear": ["mistral large 3", "millones de tokens", "qwen4"]}}
{"id": "ag-chain-01", "prompt": "Búscame qué pasó con la subasta del observatorio de Tonantzintla y lee la nota completa que encuentres para darme el detalle.", "canned_tools": {"web_search": {"query_must_mention": ["tonantzintla"], "results": [{"title": "Subasta benéfica del observatorio de Tonantzintla", "url": "https://astro-mx.example/tonantzintla-subasta", "snippet": "El observatorio de Tonantzintla anunció una subasta benéfica este fin de semana; los detalles completos están en la nota enlazada."}]}, "web_fetch": {"https://astro-mx.example/tonantzintla-subasta": "Nota completa — La subasta benéfica del observatorio de Tonantzintla reunió 3.2 millones de pesos y financiará un nuevo espectrógrafo para el programa estudiantil de astronomía."}}, "expected": {"must_call_tools": ["web_search", "web_fetch"], "final_json_keys": ["title", "summary", "items"], "facts_must_appear": ["tonantzintla", "3.2", "espectr"]}}
{"id": "ag-multitopic-01", "prompt": "Ármame un boletín doble: primero las novedades de energía solar en México y aparte el tipo de cambio del peso frente al dólar hoy.", "canned_tools": {"web_search": {"query_must_mention": ["solar", "peso"], "queries": [{"match_any": ["solar"], "results": [{"title": "Parque solar Puerto Peñasco se amplía", "url": "https://energia-mx.example/puerto-penasco", "snippet": "El parque solar de Puerto Peñasco duplicó su capacidad instalada a 1.6 gigawatts, la mayor de América Latina."}]}, {"match_any": ["peso", "dolar", "cambio"], "results": [{"title": "Tipo de cambio hoy", "url": "https://finanzas-mx.example/tipo-de-cambio", "snippet": "El peso mexicano cotiza hoy en 17.2 por dólar, con ligera apreciación semanal."}]}], "default_results": []}, "web_fetch": {}}, "expected": {"must_call_tools": ["web_search"], "final_json_keys": ["title", "summary", "items"], "facts_must_appear": ["1.6", "17.2"]}}
{"id": "ag-reformulate-01", "prompt": "Búscame las novedades del proyecto 'Ajolote Digital'; si el buscador no trae nada con ese nombre, reintenta buscando su nombre en inglés, 'Digital Axolotl'.", "canned_tools": {"web_search": {"query_must_mention": ["ajolote", "digital axolotl"], "queries": [{"match_any": ["digital axolotl"], "results": [{"title": "Digital Axolotl ships v2.0", "url": "https://opensource-mx.example/digital-axolotl", "snippet": "El proyecto Digital Axolotl liberó la versión 2.0 con soporte para 14 lenguas indígenas y un corpus abierto."}]}], "default_results": []}, "web_fetch": {}}, "expected": {"must_call_tools": ["web_search"], "final_json_keys": ["title", "summary", "items"], "facts_must_appear": ["digital axolotl", "2.0", "14"]}}
{"id": "ag-distractor-01", "prompt": "Prepárame el pronóstico del clima de mañana para Guadalajara, solo el clima.", "canned_tools": {"web_search": {"query_must_mention": ["guadalajara"], "results": [{"title": "Pronóstico Guadalajara", "url": "https://clima.example/guadalajara", "snippet": "Mañana en Guadalajara: máxima de 29 grados, cielo despejado por la mañana."}, {"title": "Lluvia vespertina", "url": "https://clima.example/guadalajara-tarde", "snippet": "Para la tarde de mañana se espera 20 por ciento de probabilidad de lluvia ligera en la zona metropolitana."}, {"title": "Aguacate al alza", "url": "https://mercados.example/aguacate", "snippet": "El precio del aguacate subió a 95 pesos por kilo en los mercados mayoristas del país."}]}, "web_fetch": {}}, "expected": {"must_call_tools": ["web_search"], "final_json_keys": ["title", "summary", "items"], "facts_must_appear": ["29", "20"], "facts_must_not_appear": ["aguacate"]}}
{"id": "ag-distractor-02", "prompt": "Resúmeme en un boletín lo de la misión lunar que trae la página https://ciencia-mx.example/boletin-lunar; incluye solo lo de la misión.", "canned_tools": {"web_search": {"query_must_mention": [], "results": []}, "web_fetch": {"https://ciencia-mx.example/boletin-lunar": "Boletín de ciencia — La misión lunar Colmena 2 alunizó con éxito en el polo sur y desplegó sus cinco microrobots exploradores; enviará datos térmicos durante 14 días. En otras noticias sin relación: la lotería nacional repartió 21 millones de pesos en el sorteo de anoche."}}, "expected": {"must_call_tools": ["web_fetch"], "final_json_keys": ["title", "summary", "items"], "facts_must_appear": ["colmena", "microrobot"], "facts_must_not_appear": ["loteria"]}}
{"id": "ag-links-01", "prompt": "Lee la portada https://tecno-mx.example/portada y ármame el boletín usando los enlaces reales de cada nota.", "canned_tools": {"web_search": {"query_must_mention": [], "results": []}, "web_fetch": {"https://tecno-mx.example/portada": {"text": "Portada Tecno MX — Nota 1: El CIDE lanza un diplomado gratuito de ciencia de datos con 500 lugares. Nota 2: Se abre la convocatoria nacional de robótica juvenil 2027.", "links": [{"text": "Diplomado del CIDE", "url": "https://tecno-mx.example/notas/diplomado-cide"}, {"text": "Robótica juvenil 2027", "url": "https://tecno-mx.example/notas/robotica-juvenil"}]}}}, "expected": {"must_call_tools": ["web_fetch"], "final_json_keys": ["title", "summary", "items"], "facts_must_appear": ["cide", "tecno-mx.example/notas/diplomado-cide"]}}
{"id": "ag-noolt-01", "prompt": "Con esto que ya te estoy pasando ármame un boletín, no necesitas buscar nada: la junta del comité vecinal se movió al jueves 23 a las 19:00 en el salón Roble, y el punto principal será votar la instalación de luminarias solares en el parque.", "canned_tools": {"web_search": {"query_must_mention": [], "results": []}, "web_fetch": {}}, "expected": {"tools_required": false, "must_call_tools": [], "final_json_keys": ["title", "summary", "items"], "facts_must_appear": ["jueves 23", "roble", "luminarias"]}}
