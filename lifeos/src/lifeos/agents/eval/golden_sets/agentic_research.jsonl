// agentic_research golden set v1 — model_audit.py agentic role.
// Multi-round agentic research mirroring axi.briefing.run_agentic_briefing:
// the harness drives a REAL tool loop (web_search + web_fetch with CANNED
// handlers, max 5 rounds, forced final synthesis) and validates the final
// briefing JSON {title, summary, items, markdown} plus planted-fact recall.
// Schema: {id, prompt, canned_tools: {web_search: {query_must_mention, results},
//          web_fetch: {url: page_text}}, expected: {must_call_tools,
//          final_json_keys, facts_must_appear}}
{"id": "ag-news-01", "prompt": "Tráeme las 3 noticias de tecnología más importantes de hoy.", "canned_tools": {"web_search": {"query_must_mention": ["tecnolog"], "results": [{"title": "Quantum Photonics raises funding round", "url": "https://technews.example/quantum-photonics", "snippet": "La startup Quantum Photonics recaudó 850 millones de dólares para fabricar chips fotónicos en Monterrey."}, {"title": "Loihi 4 announced", "url": "https://technews.example/loihi-4", "snippet": "Intel presentó el chip neuromórfico Loihi 4 con eficiencia 12x frente a su antecesor."}, {"title": "Firefox releases privacy mode", "url": "https://technews.example/firefox", "snippet": "Firefox lanzó un modo de privacidad total que bloquea rastreadores de IA por defecto."}]}, "web_fetch": {}}, "expected": {"must_call_tools": ["web_search"], "final_json_keys": ["title", "summary", "items", "markdown"], "facts_must_appear": ["quantum photonics", "850", "loihi"]}}
{"id": "ag-fetch-01", "prompt": "Resúmeme la portada de https://noticias-mx.example/portada en un boletín breve.", "canned_tools": {"web_search": {"query_must_mention": [], "results": []}, "web_fetch": {"https://noticias-mx.example/portada": "PORTADA — Noticias MX. Titular principal: El peso mexicano cierra en 16.8 por dólar, su mejor nivel del semestre. Segundo titular: El nuevo tren El Insurgente amplía su horario nocturno a partir del lunes. Tercero: La UNAM abre la convocatoria de becas de posgrado 2027."}}, "expected": {"must_call_tools": ["web_fetch"], "final_json_keys": ["title", "summary", "items", "markdown"], "facts_must_appear": ["16.8", "insurgente"]}}
{"id": "ag-clima-01", "prompt": "Prepárame el pronóstico del clima de mañana para la Ciudad de México.", "canned_tools": {"web_search": {"query_must_mention": ["clima"], "results": [{"title": "Pronóstico CDMX", "url": "https://clima.example/cdmx", "snippet": "Mañana en la Ciudad de México: máxima de 24 grados, mínima de 13, probabilidad de lluvia del 70 por ciento por la tarde."}]}, "web_fetch": {}}, "expected": {"must_call_tools": ["web_search"], "final_json_keys": ["title", "summary", "items", "markdown"], "facts_must_appear": ["24", "70"]}}
{"id": "ag-multi-01", "prompt": "Búscame las novedades de asistentes locales de IA y además lee https://lifeos.example/blog para el detalle de la última entrada.", "canned_tools": {"web_search": {"query_must_mention": ["asistente"], "results": [{"title": "Local AI assistants trend", "url": "https://ai-news.example/local-assistants", "snippet": "Los asistentes locales crecen: el proyecto OpenHome superó 40000 instalaciones este mes."}]}, "web_fetch": {"https://lifeos.example/blog": "Blog de LifeOS — última entrada: Axi ahora corre visión en la GPU integrada con gemma4-e2b y clasifica postura en menos de 2 segundos por cuadro."}}, "expected": {"must_call_tools": ["web_search", "web_fetch"], "final_json_keys": ["title", "summary", "items", "markdown"], "facts_must_appear": ["openhome", "gemma4"]}}
{"id": "ag-modelos-01", "prompt": "Ármame un resumen de los lanzamientos de modelos de IA de esta semana.", "canned_tools": {"web_search": {"query_must_mention": ["modelos"], "results": [{"title": "Mistral Large 3 released", "url": "https://ai-news.example/mistral-large-3", "snippet": "Mistral publicó Mistral Large 3 con una ventana de contexto de 2 millones de tokens y pesos abiertos."}, {"title": "Qwen4 preview", "url": "https://ai-news.example/qwen4", "snippet": "Alibaba mostró un adelanto de Qwen4 enfocado en razonamiento con herramientas."}]}, "web_fetch": {}}, "expected": {"must_call_tools": ["web_search"], "final_json_keys": ["title", "summary", "items", "markdown"], "facts_must_appear": ["mistral large 3", "millones de tokens", "qwen4"]}}
