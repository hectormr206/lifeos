// dev_planning golden set v1 — model_audit.py devplan role.
// Self-development director role (VT-3B in production, axi.dev_director):
// kind=instruction — goal -> ONE actionable coding instruction, scored by
//   deterministic keyword classes (file/function target, expected behavior,
//   tests/edge cases) + length cap; optional actionability rubric judge.
// kind=review — goal + small unified diff + tests_output -> DONE / NOT DONE,
//   scored against `satisfies` with the production verdict parser.
// Prompts are ENGLISH — dev_director's real system prompts are English.
// Schema: {id, kind, goal, max_chars?/rubric? (instruction),
//          diff/tests_output/satisfies (review)}
{"id": "dp-instr-01", "kind": "instruction", "goal": "Add a --json flag to the `axi stats` CLI command that prints the daily summary as machine-readable JSON instead of the human-readable table.", "max_chars": 1200, "rubric": {"criteria": [{"name": "actionable", "weight": 0.5, "description": "The instruction is a single concrete task an autonomous coding agent could execute without asking questions."}, {"name": "complete", "weight": 0.3, "description": "It covers the flag, the JSON output shape, and preserving the default table behavior."}, {"name": "concise", "weight": 0.2, "description": "No filler, no multiple alternatives, no meta-commentary."}]}}
{"id": "dp-instr-02", "kind": "instruction", "goal": "Fix the off-by-one bug in the pagination helper: the last page is dropped when the total item count is an exact multiple of the page size.", "max_chars": 1200, "rubric": {"criteria": [{"name": "actionable", "weight": 0.5, "description": "Points at the pagination helper and states the exact fix to make."}, {"name": "complete", "weight": 0.3, "description": "Names the boundary condition (exact multiple of page size) and requires a regression test."}, {"name": "concise", "weight": 0.2, "description": "One instruction, no rambling."}]}}
{"id": "dp-instr-03", "kind": "instruction", "goal": "Add retry with exponential backoff (max 3 attempts) to the web_fetch handler for transient HTTP 5xx errors, without retrying 4xx errors.", "max_chars": 1200, "rubric": {"criteria": [{"name": "actionable", "weight": 0.5, "description": "Targets the web_fetch handler and describes the retry mechanics concretely."}, {"name": "complete", "weight": 0.3, "description": "Covers the 5xx-only condition, the attempt cap, backoff, and tests."}, {"name": "concise", "weight": 0.2, "description": "Direct, single instruction."}]}}
{"id": "dp-rev-01", "kind": "review", "goal": "Add an is_weekend(d: date) helper to utils/dates.py returning True for Saturday and Sunday, with unit tests.", "diff": "diff --git a/utils/dates.py b/utils/dates.py\n--- a/utils/dates.py\n+++ b/utils/dates.py\n@@ -10,3 +10,8 @@ def iso_week(d: date) -> int:\n     return d.isocalendar()[1]\n+\n+\n+def is_weekend(d: date) -> bool:\n+    \"\"\"True for Saturday (5) and Sunday (6).\"\"\"\n+    return d.weekday() >= 5\ndiff --git a/tests/test_dates.py b/tests/test_dates.py\n--- a/tests/test_dates.py\n+++ b/tests/test_dates.py\n@@ -8,2 +8,10 @@\n+def test_is_weekend_saturday_and_sunday():\n+    assert is_weekend(date(2026, 7, 18)) is True   # Saturday\n+    assert is_weekend(date(2026, 7, 19)) is True   # Sunday\n+\n+\n+def test_is_weekend_weekday():\n+    assert is_weekend(date(2026, 7, 15)) is False  # Wednesday\n", "tests_output": "3 passed in 0.04s", "satisfies": true}
{"id": "dp-rev-02", "kind": "review", "goal": "Validate email addresses in validate_email(): reject strings without an @ AND strings with an empty domain part (e.g. 'user@'), returning False for both.", "diff": "diff --git a/utils/validation.py b/utils/validation.py\n--- a/utils/validation.py\n+++ b/utils/validation.py\n@@ -4,2 +4,7 @@\n+def validate_email(s: str) -> bool:\n+    \"\"\"Very small email sanity check.\"\"\"\n+    if \"@\" not in s:\n+        return False\n+    return True\n", "tests_output": "1 passed in 0.02s", "satisfies": false}
{"id": "dp-rev-03", "kind": "review", "goal": "Add a slugify(text) function to utils/text.py (lowercase, spaces to hyphens, strip accents) WITH unit tests covering accents and repeated spaces.", "diff": "diff --git a/utils/text.py b/utils/text.py\n--- a/utils/text.py\n+++ b/utils/text.py\n@@ -2,2 +2,10 @@\n+import unicodedata\n+\n+\n+def slugify(text: str) -> str:\n+    text = unicodedata.normalize(\"NFD\", text.lower())\n+    text = \"\".join(c for c in text if unicodedata.category(c) != \"Mn\")\n+    return \"-\".join(text.split())\n", "tests_output": "no tests ran in 0.01s", "satisfies": false}
{"id": "dp-rev-04", "kind": "review", "goal": "Implement clamp(value, lo, hi) in utils/math.py that bounds value into [lo, hi] from BOTH sides.", "diff": "diff --git a/utils/math.py b/utils/math.py\n--- a/utils/math.py\n+++ b/utils/math.py\n@@ -1,1 +1,5 @@\n+def clamp(value: float, lo: float, hi: float) -> float:\n+    \"\"\"Bound value into [lo, hi].\"\"\"\n+    return min(value, hi)\n", "tests_output": "FAILED tests/test_math.py::test_clamp_below_lo - assert -5 == 0\n1 failed, 1 passed in 0.03s", "satisfies": false}
{"id": "dp-rev-05", "kind": "review", "goal": "Rename the config key 'timeout' to 'timeout_s' while keeping backward compatibility: readers must accept the old key as a fallback, with a test for both paths.", "diff": "diff --git a/config.py b/config.py\n--- a/config.py\n+++ b/config.py\n@@ -22,3 +22,8 @@ def get_timeout(cfg: dict) -> float:\n-    return float(cfg.get(\"timeout\", 30.0))\n+    # New canonical key with backward-compatible fallback to the legacy name.\n+    if \"timeout_s\" in cfg:\n+        return float(cfg[\"timeout_s\"])\n+    return float(cfg.get(\"timeout\", 30.0))\ndiff --git a/tests/test_config.py b/tests/test_config.py\n--- a/tests/test_config.py\n+++ b/tests/test_config.py\n@@ -10,2 +10,12 @@\n+def test_get_timeout_new_key():\n+    assert get_timeout({\"timeout_s\": 12}) == 12.0\n+\n+\n+def test_get_timeout_legacy_fallback():\n+    assert get_timeout({\"timeout\": 7}) == 7.0\n+\n+\n+def test_get_timeout_default():\n+    assert get_timeout({}) == 30.0\n", "tests_output": "3 passed in 0.05s", "satisfies": true}
