// dev_planning golden set v1 — model_audit.py devplan role.
// Self-development director role (VT-3B in production, axi.dev_director):
// kind=instruction — goal -> ONE actionable coding instruction, scored by
//   deterministic keyword classes (file/function target, expected behavior,
//   tests/edge cases) + length cap; optional actionability rubric judge.
// kind=review — goal + small unified diff + tests_output -> DONE / NOT DONE,
//   scored against `satisfies` with the production verdict parser.
// Prompts are ENGLISH — dev_director's real system prompts are English.
// Schema: {id, kind, goal, max_chars?/rubric? (instruction),
//          diff/tests_output/satisfies (review)}
{"id": "dp-instr-01", "kind": "instruction", "goal": "Add a --json flag to the `axi stats` CLI command that prints the daily summary as machine-readable JSON instead of the human-readable table.", "max_chars": 1200, "rubric": {"criteria": [{"name": "actionable", "weight": 0.5, "description": "The instruction is a single concrete task an autonomous coding agent could execute without asking questions."}, {"name": "complete", "weight": 0.3, "description": "It covers the flag, the JSON output shape, and preserving the default table behavior."}, {"name": "concise", "weight": 0.2, "description": "No filler, no multiple alternatives, no meta-commentary."}]}}
{"id": "dp-instr-02", "kind": "instruction", "goal": "Fix the off-by-one bug in the pagination helper: the last page is dropped when the total item count is an exact multiple of the page size.", "max_chars": 1200, "rubric": {"criteria": [{"name": "actionable", "weight": 0.5, "description": "Points at the pagination helper and states the exact fix to make."}, {"name": "complete", "weight": 0.3, "description": "Names the boundary condition (exact multiple of page size) and requires a regression test."}, {"name": "concise", "weight": 0.2, "description": "One instruction, no rambling."}]}}
{"id": "dp-instr-03", "kind": "instruction", "goal": "Add retry with exponential backoff (max 3 attempts) to the web_fetch handler for transient HTTP 5xx errors, without retrying 4xx errors.", "max_chars": 1200, "rubric": {"criteria": [{"name": "actionable", "weight": 0.5, "description": "Targets the web_fetch handler and describes the retry mechanics concretely."}, {"name": "complete", "weight": 0.3, "description": "Covers the 5xx-only condition, the attempt cap, backoff, and tests."}, {"name": "concise", "weight": 0.2, "description": "Direct, single instruction."}]}}
{"id": "dp-rev-01", "kind": "review", "goal": "Add an is_weekend(d: date) helper to utils/dates.py returning True for Saturday and Sunday, with unit tests.", "diff": "diff --git a/utils/dates.py b/utils/dates.py\n--- a/utils/dates.py\n+++ b/utils/dates.py\n@@ -10,3 +10,8 @@ def iso_week(d: date) -> int:\n     return d.isocalendar()[1]\n+\n+\n+def is_weekend(d: date) -> bool:\n+    \"\"\"True for Saturday (5) and Sunday (6).\"\"\"\n+    return d.weekday() >= 5\ndiff --git a/tests/test_dates.py b/tests/test_dates.py\n--- a/tests/test_dates.py\n+++ b/tests/test_dates.py\n@@ -8,2 +8,10 @@\n+def test_is_weekend_saturday_and_sunday():\n+    assert is_weekend(date(2026, 7, 18)) is True   # Saturday\n+    assert is_weekend(date(2026, 7, 19)) is True   # Sunday\n+\n+\n+def test_is_weekend_weekday():\n+    assert is_weekend(date(2026, 7, 15)) is False  # Wednesday\n", "tests_output": "3 passed in 0.04s", "satisfies": true}
{"id": "dp-rev-02", "kind": "review", "goal": "Validate email addresses in validate_email(): reject strings without an @ AND strings with an empty domain part (e.g. 'user@'), returning False for both.", "diff": "diff --git a/utils/validation.py b/utils/validation.py\n--- a/utils/validation.py\n+++ b/utils/validation.py\n@@ -4,2 +4,7 @@\n+def validate_email(s: str) -> bool:\n+    \"\"\"Very small email sanity check.\"\"\"\n+    if \"@\" not in s:\n+        return False\n+    return True\n", "tests_output": "1 passed in 0.02s", "satisfies": false}
{"id": "dp-rev-03", "kind": "review", "goal": "Add a slugify(text) function to utils/text.py (lowercase, spaces to hyphens, strip accents) WITH unit tests covering accents and repeated spaces.", "diff": "diff --git a/utils/text.py b/utils/text.py\n--- a/utils/text.py\n+++ b/utils/text.py\n@@ -2,2 +2,10 @@\n+import unicodedata\n+\n+\n+def slugify(text: str) -> str:\n+    text = unicodedata.normalize(\"NFD\", text.lower())\n+    text = \"\".join(c for c in text if unicodedata.category(c) != \"Mn\")\n+    return \"-\".join(text.split())\n", "tests_output": "no tests ran in 0.01s", "satisfies": false}
{"id": "dp-rev-04", "kind": "review", "goal": "Implement clamp(value, lo, hi) in utils/math.py that bounds value into [lo, hi] from BOTH sides.", "diff": "diff --git a/utils/math.py b/utils/math.py\n--- a/utils/math.py\n+++ b/utils/math.py\n@@ -1,1 +1,5 @@\n+def clamp(value: float, lo: float, hi: float) -> float:\n+    \"\"\"Bound value into [lo, hi].\"\"\"\n+    return min(value, hi)\n", "tests_output": "FAILED tests/test_math.py::test_clamp_below_lo - assert -5 == 0\n1 failed, 1 passed in 0.03s", "satisfies": false}
{"id": "dp-rev-05", "kind": "review", "goal": "Rename the config key 'timeout' to 'timeout_s' while keeping backward compatibility: readers must accept the old key as a fallback, with a test for both paths.", "diff": "diff --git a/config.py b/config.py\n--- a/config.py\n+++ b/config.py\n@@ -22,3 +22,8 @@ def get_timeout(cfg: dict) -> float:\n-    return float(cfg.get(\"timeout\", 30.0))\n+    # New canonical key with backward-compatible fallback to the legacy name.\n+    if \"timeout_s\" in cfg:\n+        return float(cfg[\"timeout_s\"])\n+    return float(cfg.get(\"timeout\", 30.0))\ndiff --git a/tests/test_config.py b/tests/test_config.py\n--- a/tests/test_config.py\n+++ b/tests/test_config.py\n@@ -10,2 +10,12 @@\n+def test_get_timeout_new_key():\n+    assert get_timeout({\"timeout_s\": 12}) == 12.0\n+\n+\n+def test_get_timeout_legacy_fallback():\n+    assert get_timeout({\"timeout\": 7}) == 7.0\n+\n+\n+def test_get_timeout_default():\n+    assert get_timeout({}) == 30.0\n", "tests_output": "3 passed in 0.05s", "satisfies": true}
// ── v2 hardening (2026-07-21): harder instruction rubrics + subtler review traps.
// NOTE ON SATURATION: score_devplan_instruction.passed is PURELY deterministic
//   (keyword-class presence + length cap); the rubric judge_score is computed but
//   does NOT gate passed. So instruction_pass_rate saturates for any competent
//   model regardless of plan QUALITY. These rubrics push the JUDGE signal harder
//   (hidden deps, clarification, ordering, migration/rollback/tests), but the
//   deterministic pass_rate leniency is a SCORER property — flagged, not rewritten.
// Instruction cases 04-14: multi-step / ambiguous / ordering / risk / migration.
{"id": "dp-instr-04", "kind": "instruction", "goal": "Add a new 'sleep' record type to the tracker so users can log sleep sessions and see them in the daily summary.", "max_chars": 1200, "rubric": {"criteria": [{"name": "hidden_deps", "weight": 0.4, "description": "Surfaces the full dependency chain a new record type needs: DB schema/migration, the parser/ingest path, the aggregation into the daily summary, and any index — not just an isolated model class."}, {"name": "actionable", "weight": 0.35, "description": "A single concrete task an autonomous agent could execute without asking questions, naming target files/functions."}, {"name": "tests", "weight": 0.25, "description": "Requires migration + ingest + summary tests, including an empty-day edge case."}]}}
{"id": "dp-instr-05", "kind": "instruction", "goal": "Make the export faster.", "max_chars": 1200, "rubric": {"criteria": [{"name": "resolves_ambiguity", "weight": 0.5, "description": "The goal is under-specified (which export? faster by what measure?). A strong instruction either pins a concrete, reasonable target (e.g. the CSV export path, batching DB reads) with a STATED assumption, or explicitly flags the missing acceptance criterion — it must NOT silently guess a random subsystem."}, {"name": "actionable", "weight": 0.3, "description": "Concrete enough to execute: names the target and the optimization approach."}, {"name": "tests", "weight": 0.2, "description": "Requires a benchmark or regression test proving the speedup and unchanged output."}]}}
{"id": "dp-instr-06", "kind": "instruction", "goal": "Add a non-null `created_at` timestamp column to the existing `entries` table and start populating it on insert.", "max_chars": 1200, "rubric": {"criteria": [{"name": "ordering", "weight": 0.45, "description": "Gets the sequencing right: a NOT NULL column on an EXISTING table needs a backfill/default before or during the migration, and the write path must be updated in the same change — otherwise existing rows or concurrent inserts break."}, {"name": "actionable", "weight": 0.3, "description": "Names the migration file, the table, and the insert path to modify."}, {"name": "tests", "weight": 0.25, "description": "Requires a migration test AND a test that old rows are backfilled, not just new inserts."}]}}
{"id": "dp-instr-07", "kind": "instruction", "goal": "Add a per-user daily request counter that increments on every API call and resets at midnight UTC.", "max_chars": 1200, "rubric": {"criteria": [{"name": "risk_edge", "weight": 0.45, "description": "Identifies the concurrency and boundary risks: the increment must be atomic under concurrent requests, and the midnight-UTC reset must define what happens to in-flight requests crossing the boundary."}, {"name": "actionable", "weight": 0.3, "description": "Names the counter store/function and the reset mechanism concretely."}, {"name": "tests", "weight": 0.25, "description": "Requires a concurrency test and a reset-at-boundary test."}]}}
{"id": "dp-instr-08", "kind": "instruction", "goal": "Rename the `user.fullname` field to `user.full_name` across the codebase and database.", "max_chars": 1200, "rubric": {"criteria": [{"name": "migration", "weight": 0.45, "description": "Treats this as a data migration, not a rename: requires a DB column migration, a backfill/copy step, and a backward-compatible read path (or a documented two-phase deploy) so no live data or old clients break."}, {"name": "actionable", "weight": 0.3, "description": "Names the model, the migration, and the call sites."}, {"name": "tests", "weight": 0.25, "description": "Requires tests for both the new field and the compatibility/fallback path."}]}}
{"id": "dp-instr-09", "kind": "instruction", "goal": "Roll out the new ranking algorithm to production.", "max_chars": 1200, "rubric": {"criteria": [{"name": "rollback", "weight": 0.45, "description": "Plans for reversibility: gates the new algorithm behind a feature flag / config switch with a fast rollback path, rather than an irreversible hard swap."}, {"name": "actionable", "weight": 0.3, "description": "Names the flag, the module, and the default/off state."}, {"name": "tests", "weight": 0.25, "description": "Requires tests for both flag states and a metric/guard to detect regression before full rollout."}]}}
{"id": "dp-instr-10", "kind": "instruction", "goal": "The test test_expiry_cleanup is flaky in CI — sometimes it passes, sometimes it fails. Make it reliable.", "max_chars": 1200, "rubric": {"criteria": [{"name": "root_cause", "weight": 0.45, "description": "Attributes flakiness to a real cause (wall-clock/time dependence, ordering, or shared state) and fixes it deterministically, e.g. by freezing/injecting the clock — NOT by adding sleeps, retries, or a skip."}, {"name": "actionable", "weight": 0.3, "description": "Names the test and the code under test to change."}, {"name": "tests", "weight": 0.25, "description": "Requires the test to be deterministic and to still assert the real expiry behavior."}]}}
{"id": "dp-instr-11", "kind": "instruction", "goal": "Add a delete_account endpoint that removes a user and all their data.", "max_chars": 1200, "rubric": {"criteria": [{"name": "hidden_deps", "weight": 0.4, "description": "Surfaces the cascade: related records across tables, cached data, and any external artifacts must be handled (cascade or explicit cleanup), and authorization must be enforced so a user cannot delete another account."}, {"name": "actionable", "weight": 0.35, "description": "Names the endpoint/handler, the authorization check, and the deletion path."}, {"name": "tests", "weight": 0.25, "description": "Requires tests for full cleanup, the authorization boundary, and idempotent re-delete."}]}}
{"id": "dp-instr-12", "kind": "instruction", "goal": "Cache the expensive get_dashboard_stats() result so repeated calls are fast.", "max_chars": 1200, "rubric": {"criteria": [{"name": "invalidation", "weight": 0.45, "description": "Addresses cache invalidation / staleness: defines a TTL or an explicit invalidation on the writes that change the underlying stats, so the cache cannot serve stale data indefinitely."}, {"name": "actionable", "weight": 0.3, "description": "Names the function, the cache key, and where invalidation is triggered."}, {"name": "tests", "weight": 0.25, "description": "Requires a cache-hit test AND a staleness/invalidation test."}]}}
{"id": "dp-instr-13", "kind": "instruction", "goal": "Add a search box that filters entries by a user-supplied query string against the notes column.", "max_chars": 1200, "rubric": {"criteria": [{"name": "risk_edge", "weight": 0.45, "description": "Flags the injection risk: the query must be parameterized (no string-built SQL), and empty/oversized/special-character queries must be handled safely."}, {"name": "actionable", "weight": 0.3, "description": "Names the query function and the parameterized query approach."}, {"name": "tests", "weight": 0.25, "description": "Requires tests for a normal match, no match, and a malicious/special-character input."}]}}
{"id": "dp-instr-14", "kind": "instruction", "goal": "We want offline-first sync: the app should work without a network and reconcile changes when it reconnects.", "max_chars": 1200, "rubric": {"criteria": [{"name": "decomposition", "weight": 0.5, "description": "Recognizes this is too large for one instruction and slices it SDD-style (local write queue -> change log -> conflict-resolution policy -> reconciliation on reconnect), or scopes down to the first buildable slice with the conflict strategy named — rather than emitting one vague do-everything instruction."}, {"name": "actionable", "weight": 0.3, "description": "The chosen first slice is concrete and executable, naming the storage/queue and the conflict rule."}, {"name": "tests", "weight": 0.2, "description": "Requires tests for the offline write path and a conflicting-reconnect scenario."}]}}
// Review cases 06-26: subtle diffs where the label needs real code judgment,
// not keyword matching. DONE-traps (look complete, miss an edge) and
// NOT-DONE-traps (look broken, actually correct). Ground truth in `satisfies`.
{"id": "dp-rev-06", "kind": "review", "goal": "Add a nullable `archived_at` timestamp column to the `entries` table via a migration so entries can be soft-deleted.", "diff": "diff --git a/models/entry.py b/models/entry.py\n--- a/models/entry.py\n+++ b/models/entry.py\n@@ -12,6 +12,7 @@ class Entry(Base):\n     id = Column(Integer, primary_key=True)\n     notes = Column(Text)\n     created_at = Column(DateTime, nullable=False)\n+    archived_at = Column(DateTime, nullable=True)\n", "tests_output": "2 passed in 0.06s", "satisfies": false}
{"id": "dp-rev-07", "kind": "review", "goal": "Add a nullable `archived_at` timestamp column to the `entries` table via a migration so entries can be soft-deleted.", "diff": "diff --git a/models/entry.py b/models/entry.py\n--- a/models/entry.py\n+++ b/models/entry.py\n@@ -12,6 +12,7 @@ class Entry(Base):\n     created_at = Column(DateTime, nullable=False)\n+    archived_at = Column(DateTime, nullable=True)\ndiff --git a/migrations/0042_add_archived_at.py b/migrations/0042_add_archived_at.py\n--- /dev/null\n+++ b/migrations/0042_add_archived_at.py\n@@ -0,0 +1,7 @@\n+def upgrade(op):\n+    op.add_column('entries', Column('archived_at', DateTime, nullable=True))\n+\n+def downgrade(op):\n+    op.drop_column('entries', 'archived_at')\n", "tests_output": "3 passed in 0.07s", "satisfies": true}
{"id": "dp-rev-08", "kind": "review", "goal": "Add a NOT NULL `status` column (default 'active') to the existing `users` table and migrate existing rows.", "diff": "diff --git a/migrations/0043_add_status.py b/migrations/0043_add_status.py\n--- /dev/null\n+++ b/migrations/0043_add_status.py\n@@ -0,0 +1,3 @@\n+def upgrade(op):\n+    # existing rows will violate NOT NULL — no backfill/default provided\n+    op.add_column('users', Column('status', String, nullable=False))\n", "tests_output": "1 passed in 0.02s", "satisfies": false}
{"id": "dp-rev-09", "kind": "review", "goal": "Retry the outbound webhook on transient 5xx errors only (max 3 attempts, exponential backoff); never retry 4xx.", "diff": "diff --git a/webhooks.py b/webhooks.py\n--- a/webhooks.py\n+++ b/webhooks.py\n@@ -8,3 +8,12 @@\n+def send(url, payload):\n+    for attempt in range(3):\n+        resp = http_post(url, payload)\n+        if resp.status_code < 400:\n+            return resp\n+        time.sleep(2 ** attempt)\n+    return resp\n", "tests_output": "2 passed in 0.05s", "satisfies": false}
{"id": "dp-rev-10", "kind": "review", "goal": "Retry the outbound webhook on transient 5xx errors only (max 3 attempts, exponential backoff); never retry 4xx.", "diff": "diff --git a/webhooks.py b/webhooks.py\n--- a/webhooks.py\n+++ b/webhooks.py\n@@ -8,3 +8,13 @@\n+def send(url, payload):\n+    for attempt in range(3):\n+        resp = http_post(url, payload)\n+        if resp.status_code < 500:\n+            return resp  # 2xx/3xx success or 4xx: do not retry\n+        if attempt < 2:\n+            time.sleep(2 ** attempt)\n+    return resp\n", "tests_output": "3 passed in 0.06s", "satisfies": true}
{"id": "dp-rev-11", "kind": "review", "goal": "Cache get_settings() results in-process, but invalidate the cache whenever save_settings() writes new values.", "diff": "diff --git a/settings.py b/settings.py\n--- a/settings.py\n+++ b/settings.py\n@@ -3,6 +3,15 @@\n+_cache = {}\n+\n+def get_settings(user_id):\n+    if user_id not in _cache:\n+        _cache[user_id] = _load_settings(user_id)\n+    return _cache[user_id]\n+\n+def save_settings(user_id, values):\n+    _write_settings(user_id, values)\n", "tests_output": "2 passed in 0.04s", "satisfies": false}
{"id": "dp-rev-12", "kind": "review", "goal": "Add average_speed(distance, elapsed) returning distance/elapsed, safely handling elapsed == 0 by returning 0.0.", "diff": "diff --git a/metrics.py b/metrics.py\n--- a/metrics.py\n+++ b/metrics.py\n@@ -1,1 +1,4 @@\n+def average_speed(distance, elapsed):\n+    return distance / elapsed\n", "tests_output": "FAILED tests/test_metrics.py::test_zero_elapsed - ZeroDivisionError\n1 failed, 1 passed in 0.03s", "satisfies": false}
{"id": "dp-rev-13", "kind": "review", "goal": "Add average_speed(distance, elapsed) returning distance/elapsed, safely handling elapsed == 0 by returning 0.0.", "diff": "diff --git a/metrics.py b/metrics.py\n--- a/metrics.py\n+++ b/metrics.py\n@@ -1,1 +1,6 @@\n+def average_speed(distance, elapsed):\n+    if elapsed == 0:\n+        return 0.0\n+    return distance / elapsed\ndiff --git a/tests/test_metrics.py b/tests/test_metrics.py\n@@ -1,2 +1,6 @@\n+def test_zero_elapsed():\n+    assert average_speed(10, 0) == 0.0\n+def test_normal():\n+    assert average_speed(10, 2) == 5.0\n", "tests_output": "2 passed in 0.03s", "satisfies": true}
{"id": "dp-rev-14", "kind": "review", "goal": "Implement is_palindrome(s) that ignores case and spaces, WITH tests that actually exercise the behavior.", "diff": "diff --git a/strutil.py b/strutil.py\n--- a/strutil.py\n+++ b/strutil.py\n@@ -1,1 +1,4 @@\n+def is_palindrome(s):\n+    t = s.replace(' ', '').lower()\n+    return t == t[::-1]\ndiff --git a/tests/test_strutil.py b/tests/test_strutil.py\n@@ -1,2 +1,4 @@\n+def test_is_palindrome():\n+    assert True  # placeholder\n", "tests_output": "1 passed in 0.02s", "satisfies": false}
{"id": "dp-rev-15", "kind": "review", "goal": "Add clamp(v, lo, hi) bounding v into [lo, hi] on both sides, with passing tests.", "diff": "diff --git a/mathutil.py b/mathutil.py\n--- a/mathutil.py\n+++ b/mathutil.py\n@@ -1,1 +1,3 @@\n+def clamp(v, lo, hi):\n+    return max(lo, min(v, hi))\ndiff --git a/tests/test_mathutil.py b/tests/test_mathutil.py\n@@ -1,2 +1,5 @@\n+def test_clamp():\n+    assert clamp(-1, 0, 10) == 0\n+    assert clamp(99, 0, 10) == 10\n", "tests_output": "FAILED tests/test_mathutil.py::test_clamp - NameError: name 'min' is not defined (shadowed)\n1 failed in 0.03s", "satisfies": false}
{"id": "dp-rev-16", "kind": "review", "goal": "Increment the shared `hits` counter safely under concurrent requests using a lock.", "diff": "diff --git a/counter.py b/counter.py\n--- a/counter.py\n+++ b/counter.py\n@@ -1,4 +1,7 @@\n hits = 0\n+\n+def bump():\n+    global hits\n+    hits += 1\n", "tests_output": "1 passed in 0.02s", "satisfies": false}
{"id": "dp-rev-17", "kind": "review", "goal": "Increment the shared `hits` counter safely under concurrent requests using a lock.", "diff": "diff --git a/counter.py b/counter.py\n--- a/counter.py\n+++ b/counter.py\n@@ -1,4 +1,9 @@\n import threading\n hits = 0\n+_lock = threading.Lock()\n+\n+def bump():\n+    global hits\n+    with _lock:\n+        hits += 1\n", "tests_output": "2 passed in 0.04s", "satisfies": true}
{"id": "dp-rev-18", "kind": "review", "goal": "Store event timestamps as timezone-aware UTC datetimes so comparisons across zones are correct.", "diff": "diff --git a/events.py b/events.py\n--- a/events.py\n+++ b/events.py\n@@ -2,2 +2,5 @@\n+from datetime import datetime\n+\n+def now_stamp():\n+    return datetime.now()\n", "tests_output": "1 passed in 0.02s", "satisfies": false}
{"id": "dp-rev-19", "kind": "review", "goal": "Store event timestamps as timezone-aware UTC datetimes so comparisons across zones are correct.", "diff": "diff --git a/events.py b/events.py\n--- a/events.py\n+++ b/events.py\n@@ -2,2 +2,5 @@\n+from datetime import datetime, timezone\n+\n+def now_stamp():\n+    return datetime.now(timezone.utc)\ndiff --git a/tests/test_events.py b/tests/test_events.py\n@@ -1,2 +1,4 @@\n+def test_now_stamp_is_aware():\n+    assert now_stamp().tzinfo is not None\n", "tests_output": "2 passed in 0.03s", "satisfies": true}
{"id": "dp-rev-20", "kind": "review", "goal": "Look up a user's row by id in get_user(uid) using a parameterized query (no SQL string interpolation).", "diff": "diff --git a/repo.py b/repo.py\n--- a/repo.py\n+++ b/repo.py\n@@ -5,2 +5,4 @@\n+def get_user(uid):\n+    return db.execute(f\"SELECT * FROM users WHERE id = {uid}\").fetchone()\n", "tests_output": "1 passed in 0.02s", "satisfies": false}
{"id": "dp-rev-21", "kind": "review", "goal": "Look up a user's row by id in get_user(uid) using a parameterized query (no SQL string interpolation).", "diff": "diff --git a/repo.py b/repo.py\n--- a/repo.py\n+++ b/repo.py\n@@ -5,2 +5,4 @@\n+def get_user(uid):\n+    return db.execute(\"SELECT * FROM users WHERE id = ?\", (uid,)).fetchone()\n", "tests_output": "2 passed in 0.03s", "satisfies": true}
{"id": "dp-rev-22", "kind": "review", "goal": "Return the last `n` items from a list in last_n(items, n); n larger than the list returns all items, n == 0 returns an empty list.", "diff": "diff --git a/listutil.py b/listutil.py\n--- a/listutil.py\n+++ b/listutil.py\n@@ -1,1 +1,3 @@\n+def last_n(items, n):\n+    return items[-n:]\n", "tests_output": "2 passed in 0.02s", "satisfies": false}
{"id": "dp-rev-23", "kind": "review", "goal": "Return the last `n` items from a list in last_n(items, n); n larger than the list returns all items, n == 0 returns an empty list.", "diff": "diff --git a/listutil.py b/listutil.py\n--- a/listutil.py\n+++ b/listutil.py\n@@ -1,1 +1,5 @@\n+def last_n(items, n):\n+    if n <= 0:\n+        return []\n+    return items[-n:]\ndiff --git a/tests/test_listutil.py b/tests/test_listutil.py\n@@ -1,2 +1,6 @@\n+def test_last_n():\n+    assert last_n([1,2,3], 5) == [1,2,3]\n+    assert last_n([1,2,3], 0) == []\n+    assert last_n([1,2,3], 2) == [2,3]\n", "tests_output": "3 passed in 0.03s", "satisfies": true}
{"id": "dp-rev-24", "kind": "review", "goal": "Add a --dry-run flag to the purge command so it prints what WOULD be deleted without deleting anything.", "diff": "diff --git a/commands/purge.py b/commands/purge.py\n--- a/commands/purge.py\n+++ b/commands/purge.py\n@@ -4,6 +4,11 @@ def purge(args):\n     targets = find_expired()\n+    if args.dry_run:\n+        for t in targets:\n+            print(f\"would delete {t}\")\n     for t in targets:\n         delete(t)\n", "tests_output": "1 passed in 0.02s", "satisfies": false}
{"id": "dp-rev-25", "kind": "review", "goal": "Add a --dry-run flag to the purge command so it prints what WOULD be deleted without deleting anything.", "diff": "diff --git a/commands/purge.py b/commands/purge.py\n--- a/commands/purge.py\n+++ b/commands/purge.py\n@@ -4,6 +4,12 @@ def purge(args):\n     targets = find_expired()\n+    if args.dry_run:\n+        for t in targets:\n+            print(f\"would delete {t}\")\n+        return\n     for t in targets:\n         delete(t)\ndiff --git a/tests/test_purge.py b/tests/test_purge.py\n@@ -1,2 +1,6 @@\n+def test_dry_run_deletes_nothing(mock_delete):\n+    purge(Args(dry_run=True))\n+    mock_delete.assert_not_called()\n", "tests_output": "2 passed in 0.05s", "satisfies": true}
{"id": "dp-rev-26", "kind": "review", "goal": "Deprecate the public helper old_format(x): keep it working as a thin wrapper that warns, and route callers to new_format(x).", "diff": "diff --git a/formatting.py b/formatting.py\n--- a/formatting.py\n+++ b/formatting.py\n@@ -10,6 +10,3 @@\n-def old_format(x):\n-    return _legacy_impl(x)\n+def new_format(x):\n+    return _impl(x)\n", "tests_output": "1 passed in 0.02s", "satisfies": false}
