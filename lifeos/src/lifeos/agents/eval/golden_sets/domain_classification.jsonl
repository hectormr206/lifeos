// Golden set for nano extractor domain-classification eval — v2
// Format: {"text": str, "expected_domain": str|null, "layer": str, "note": str (optional)}
// Valid domains: finance, relationships, exercise, learning, health, events, spirituality
// Use null (not the string) when no domain should be extracted.
// Run eval: cd ~/LifeOS/lifeos/lifeos && .venv/bin/python -m lifeos.agents.eval._run_eval
//
// layer values:
//   "nano"  — nano extractor is called and its prediction is what matters (decision metric)
//   "regex" — regex finance parser (lifeos/finance/ingestion.py) fires BEFORE nano;
//             nano result is irrelevant in production for these cases.
//             Patterns: gasté/pagué + number (_OUTFLOW_RE), compré X por/a/en N (_PURCHASE_RE),
//             cobré/me llegó/me depositaron/recibí N (_INCOME_RE), ahorré N (_SAVINGS_RE).
//             Note: itemized tickets (colon + multiple item/number pairs) are DECLINED by
//             _ITEMIZED_LIST_RE and fall through to nano, so those are labelled "nano".
//   "guard" — dashboard guard short-circuits regardless of nano output:
//             (a) text < 12 chars → nano not called at all.
//             (b) spirituality result with no title/kind on text < 20 chars → discarded.

// ── FINANCE (5 cases) ──────────────────────────────────────────────────────
{"text": "Gasté 500 pesos en el super", "expected_domain": "finance", "layer": "regex", "note": "classic regex-trivial finance case — _OUTFLOW_RE matches"}
{"text": "Pagué 1850 en Aurrera: detergente, papel, cable HDMI", "expected_domain": "finance", "layer": "regex", "note": "regex outflow matches; _ITEMIZED_LIST_RE does NOT block (no item+number pairs after colon)"}
{"text": "Me cobraron 230 de Uber esta mañana", "expected_domain": "finance", "layer": "nano", "note": "cobraron (passive) not in _INCOME_RE (which needs cobré/me llegó/me depositaron/recibí) — falls to nano"}
{"text": "Compré los tenis en $1299, los de descuento", "expected_domain": "finance", "layer": "regex", "note": "_PURCHASE_RE now catches this: comma boundary fix in lookahead allows amount followed by ','."}
{"text": "Salió 3400 la cena para 4 personas en el restaurante", "expected_domain": "finance", "layer": "regex", "note": "_OUTFLOW_RE now catches this: sali[óoò] added to verb alternation; optional connector allows 'Salió N <free-text>'."}

// ── RELATIONSHIPS (4 cases) ────────────────────────────────────────────────
{"text": "Hablé con Diego sobre el proyecto de trabajo", "expected_domain": "relationships", "layer": "nano"}
{"text": "Tuve una discusión fuerte con mi mamá esta tarde", "expected_domain": "relationships", "layer": "nano"}
{"text": "Llamé a mi hermana para ver cómo estaba", "expected_domain": "relationships", "layer": "nano"}
{"text": "Conocí a los papás de mi novia en la cena", "expected_domain": "relationships", "layer": "nano"}

// ── EXERCISE (5 cases) ─────────────────────────────────────────────────────
{"text": "Corrí 5km en el parque esta mañana", "expected_domain": "exercise", "layer": "nano"}
{"text": "Fui al gym a entrenar pierna, 1 hora", "expected_domain": "exercise", "layer": "nano"}
{"text": "Caminé con mi esposa Daniela durante 45 minutos", "expected_domain": "exercise", "layer": "nano", "note": "walk with person — should be exercise not relationships"}
{"text": "Hice 30 minutos de yoga en casa", "expected_domain": "exercise", "layer": "nano"}
{"text": "Entrené fuerza con pesas hoy en la mañana", "expected_domain": "exercise", "layer": "nano"}

