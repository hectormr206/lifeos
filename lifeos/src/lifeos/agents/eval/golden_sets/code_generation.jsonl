// Golden set for code-generation eval (the 35B's nightly self-development role) — v1
// Prompts are Spanish (Axi's dev director speaks Spanish to the model) and mirror
// dev_director.py's instruction style: one precise task — target function, expected
// behavior, edge cases. The harness EXECUTES the generated code in a sandboxed
// subprocess (model_audit.py execute_codegen_harness) — never exec() in-process.
// Format: {"id", "prompt", "function_name", "tests": [{"args": [...],
//          "kwargs"?: {...}, "expected": any}], "timeout_s"}
// Pass = every test's function_name(*args, **kwargs) == expected.
{"id": "cg01", "prompt": "Escribe una función `parse_duracion(texto)` que convierta una duración escrita en español a minutos (int). Debe soportar: 'N horas' / 'N hora' (N entero), 'N minutos' / 'N minuto', 'N horas y media' (suma 30 minutos) y 'media hora' (30). Ignora mayúsculas/minúsculas. Si el texto no coincide con ningún formato, devuelve None. Sin dependencias externas.", "function_name": "parse_duracion", "tests": [{"args": ["2 horas y media"], "expected": 150}, {"args": ["45 minutos"], "expected": 45}, {"args": ["1 hora"], "expected": 60}, {"args": ["media hora"], "expected": 30}, {"args": ["sin tiempo definido"], "expected": null}], "timeout_s": 10}
{"id": "cg02", "prompt": "Escribe una función `normalizar_nombre(nombre)` que limpie un nombre de persona: recorta espacios al inicio y al final, colapsa espacios múltiples internos a uno solo, y deja cada palabra con inicial mayúscula y el resto en minúsculas (por ejemplo 'juan PÉREZ' → 'Juan Pérez'). Caso borde: cadena vacía o solo espacios → devuelve ''.", "function_name": "normalizar_nombre", "tests": [{"args": ["  juan PÉREZ  "], "expected": "Juan Pérez"}, {"args": ["ana   maría lópez"], "expected": "Ana María López"}, {"args": ["   "], "expected": ""}], "timeout_s": 10}
{"id": "cg03", "prompt": "Escribe una función `top_gastos(gastos, n)` donde `gastos` es una lista de dicts con claves 'concepto' (str) y 'monto' (número). Devuelve la lista de los n conceptos con mayor monto, ordenados de mayor a menor monto; ante empate de monto conserva el orden original de la lista (orden estable). Casos borde: n <= 0 devuelve []; si n es mayor que la cantidad de gastos, devuelve todos.", "function_name": "top_gastos", "tests": [{"args": [[{"concepto": "super", "monto": 450}, {"concepto": "cine", "monto": 180}, {"concepto": "renta", "monto": 7000}, {"concepto": "luz", "monto": 320}], 2], "expected": ["renta", "super"]}, {"args": [[{"concepto": "a", "monto": 100}, {"concepto": "b", "monto": 100}], 2], "expected": ["a", "b"]}, {"args": [[{"concepto": "a", "monto": 100}], 0], "expected": []}], "timeout_s": 10}
{"id": "cg04", "prompt": "Escribe una función `dias_entre(fecha_inicio, fecha_fin)` que reciba dos fechas en formato ISO 'YYYY-MM-DD' (str) y devuelva el número de días entre ambas como int, siempre >= 0 (usa el valor absoluto de la diferencia). Usa datetime de la librería estándar. Caso borde: fechas iguales → 0.", "function_name": "dias_entre", "tests": [{"args": ["2026-01-01", "2026-01-31"], "expected": 30}, {"args": ["2026-03-10", "2026-03-10"], "expected": 0}, {"args": ["2026-02-05", "2026-01-31"], "expected": 5}], "timeout_s": 10}
{"id": "cg05", "prompt": "Escribe una función `extraer_montos(texto)` que use una expresión regular para extraer todos los montos con signo de pesos del texto, con formato $1,234.56 — las comas de miles y la parte decimal son opcionales (acepta $250, $99.99, $1,100.75). Devuelve una lista de floats en orden de aparición, quitando las comas. Caso borde: sin montos en el texto → devuelve [].", "function_name": "extraer_montos", "tests": [{"args": ["pagué $250 y luego $1,100.75 en total"], "expected": [250.0, 1100.75]}, {"args": ["hoy no gasté nada"], "expected": []}, {"args": ["$99.99"], "expected": [99.99]}], "timeout_s": 10}
{"id": "cg06", "prompt": "Escribe una clase `Racha` que registre los días (enteros) en que se cumplió un hábito, con un método `marcar(dia)` que registra un día y un método `maxima()` que devuelve la racha máxima de días consecutivos (int). Los días duplicados no cuentan doble y pueden marcarse en cualquier orden. Además escribe una función `racha_maxima(dias)` que cree una Racha, marque cada día de la lista `dias` y devuelva `maxima()`. Caso borde: lista vacía → 0.", "function_name": "racha_maxima", "tests": [{"args": [[1, 2, 3, 5, 6]], "expected": 3}, {"args": [[]], "expected": 0}, {"args": [[4, 4, 5]], "expected": 2}, {"args": [[10, 8, 9, 7]], "expected": 4}], "timeout_s": 10}
{"id": "cg07", "prompt": "Escribe una función `dividir_gastos(total, personas)` que reparta un gasto en partes iguales y devuelva `round(total / personas, 2)` (float). Casos borde OBLIGATORIOS: si personas <= 0 o total < 0, devuelve None (nunca lances excepción); total igual a 0 devuelve 0.0.", "function_name": "dividir_gastos", "tests": [{"args": [100, 3], "expected": 33.33}, {"args": [100, 0], "expected": null}, {"args": [0, 4], "expected": 0.0}, {"args": [-5, 2], "expected": null}], "timeout_s": 10}
{"id": "cg08", "prompt": "Escribe una función `es_palindromo(texto)` que devuelva True si el texto es un palíndromo ignorando mayúsculas/minúsculas, espacios, los signos . , ; : ! ? ¿ ¡ y los acentos (trata á como a, é como e, í como i, ó como o, ú como u). Caso borde: cadena vacía o que quede vacía tras limpiar → True.", "function_name": "es_palindromo", "tests": [{"args": ["Anita lava la tina"], "expected": true}, {"args": ["¿Acaso hubo búhos acá?"], "expected": true}, {"args": ["hola mundo"], "expected": false}, {"args": [""], "expected": true}], "timeout_s": 10}
