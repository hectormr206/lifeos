{"id": "vq20", "image": "vision_assets/scene_three.png", "question": "¿Cuántas figuras hay en la imagen? Responde solo el número.", "must_contain": [["tres", "3"]]}
{"id": "vq21", "image": "vision_assets/scene_three.png", "question": "¿Qué figura está más a la izquierda? Responde solo el nombre de la figura.", "must_contain": [["cuadrado", "square", "cuadro"]]}
