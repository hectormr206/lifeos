// Golden set for vision quality eval — v1 + hardened synthetic expansion.
// Format: {"id", "image": relative path under golden_sets/, "question": str (Spanish),
//          "must_contain": [[alt1, alt2, ...], ...]} — every group must be satisfied by
//          at least ONE alternative (case- and accent-insensitive substring match).
// Assets are tiny DETERMINISTIC PNGs generated with PIL + matplotlib by
// axi/scripts/bench/model_audit.py ensure_vision_assets() — regenerate anytime.
// These are SYNTHETIC panels/shapes/charts (digit-, shape- and chart-reading);
// they do NOT test real-world photo robustness (glare, blur, perspective).
// Requires launching the candidate with --mmproj; role is skipped (with a note) otherwise.
// ── v1 originals: single-attribute naming ────────────────────────────────────
{"id": "vq01", "image": "vision_assets/red_square.png", "question": "¿De qué color es el cuadrado en la imagen? Responde solo el color.", "must_contain": [["rojo", "red"]]}
{"id": "vq02", "image": "vision_assets/blue_circle.png", "question": "¿Qué figura geométrica aparece en la imagen y de qué color es?", "must_contain": [["circulo", "circle", "redond"], ["azul", "blue"]]}
{"id": "vq03", "image": "vision_assets/green_triangle.png", "question": "¿De qué color es el triángulo?", "must_contain": [["verde", "green"]]}
{"id": "vq04", "image": "vision_assets/text_hola.png", "question": "¿Qué palabra está escrita en la imagen?", "must_contain": [["hola"]]}
{"id": "vq05", "image": "vision_assets/bar_chart.png", "question": "¿Cuántas barras tiene la gráfica? Responde solo el número.", "must_contain": [["tres", "3"]]}
{"id": "vq06", "image": "vision_assets/two_shapes.png", "question": "¿Cuántas figuras hay en la imagen? Responde solo el número.", "must_contain": [["dos", "2"]]}
{"id": "vq07", "image": "vision_assets/yellow_bg.png", "question": "¿De qué color es el fondo de esta imagen?", "must_contain": [["amarillo", "yellow"]]}
{"id": "vq08", "image": "vision_assets/black_cross.png", "question": "Describe brevemente el símbolo negro que aparece sobre el fondo blanco.", "must_contain": [["cruz", "cross", "equis", "x", "mas", "plus"]]}
// ── promoted v2: reasoning over the existing PNGs (negation, counting) ────────
{"id": "vq09", "image": "vision_assets/red_square.png", "question": "¿Aparece algún círculo en la imagen? Responde solo sí o no.", "must_contain": [["no", "ningun", "cero"]], "note": "negation/absence: only a red square is present"}
{"id": "vq10", "image": "vision_assets/green_triangle.png", "question": "¿Cuántos lados tiene la figura de la imagen? Responde solo el número.", "must_contain": [["3", "tres"]], "note": "a triangle has 3 sides"}
{"id": "vq11", "image": "vision_assets/text_hola.png", "question": "¿Cuántas letras tiene la palabra escrita en la imagen?", "must_contain": [["4", "cuatro"]], "note": "OCR + count: 'hola' has 4 letters"}
{"id": "vq12", "image": "vision_assets/blue_circle.png", "question": "¿El contorno de la figura tiene esquinas o es totalmente curvo? Responde en una palabra.", "must_contain": [["curv", "redond", "sin esquinas"]], "note": "geometry attribute over a circle"}
{"id": "vq13", "image": "vision_assets/two_shapes.png", "question": "¿Hay una sola figura o hay más de una? Responde brevemente.", "must_contain": [["mas de una", "dos", "varias", "2"]], "note": "cardinality discrimination (>1)"}
