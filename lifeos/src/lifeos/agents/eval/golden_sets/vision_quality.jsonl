{"id": "vq05", "image": "vision_assets/bar_chart.png", "question": "¿Cuántas barras tiene la gráfica? Responde solo el número.", "must_contain": [["tres", "3"]]}
{"id": "vq06", "image": "vision_assets/two_shapes.png", "question": "¿Cuántas figuras hay en la imagen? Responde solo el número.", "must_contain": [["dos", "2"]]}
{"id": "vq07", "image": "vision_assets/yellow_bg.png", "question": "¿De qué color es el fondo de esta imagen?", "must_contain": [["amarillo", "yellow"]]}
