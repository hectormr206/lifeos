# tool_stress v1 — MCP-style tool-protocol robustness (model_audit.py toolstress role).
# Every case offers the FULL confusable registry (model_audit.TOOLSTRESS_REGISTRY, ~13 tools).
# Kinds: selection (right tool among plausible-but-wrong neighbours), nested_args (exact deep
# JSON args: enums + ISO dates + nested objects), error_recovery (canned first_error → the model
# must retry the SAME tool with corrected args), procedure (skill-like doc in the system prompt:
# ordered steps with values threaded from canned step results). Deterministic scoring only.
{"id": "ts-sel-reminder-01", "kind": "selection", "prompt": "Hoy es miércoles 15 de julio de 2026. Recuérdame tomar la pastilla de la presión mañana a las 8 de la mañana.", "expected": {"tool": "create_reminder", "required_args_subset": {"text": "pastilla", "when_iso": "2026-07-16T08:00"}, "forbidden_tools": ["create_task", "create_calendar_event", "send_notification"]}}
{"id": "ts-sel-memory-01", "kind": "selection", "prompt": "Busca en mis recuerdos qué acordamos Mariana y yo sobre el viaje a Oaxaca el mes pasado.", "expected": {"tool": "search_memory", "required_args_subset": {"query": "oaxaca"}, "forbidden_tools": ["search_web", "search_files"]}}
{"id": "ts-sel-health-01", "kind": "selection", "prompt": "Enséñame mis registros de presión arterial del 1 al 7 de julio de 2026, medición por medición, no el resumen.", "expected": {"tool": "get_health_entries", "required_args_subset": {"metric": "pressure", "date_range.from": "2026-07-01", "date_range.to": "2026-07-07"}, "forbidden_tools": ["get_health_summary", "search_memory", "export_data"]}}
{"id": "ts-sel-message-01", "kind": "selection", "prompt": "Mándale un mensaje a Karla diciéndole que llego 10 minutos tarde a la comida.", "expected": {"tool": "send_message", "required_args_subset": {"recipient": "karla", "text": "tarde"}, "forbidden_tools": ["send_notification", "create_reminder"]}}
