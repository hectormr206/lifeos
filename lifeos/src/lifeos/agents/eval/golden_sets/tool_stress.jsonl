# tool_stress v1 — MCP-style tool-protocol robustness (model_audit.py toolstress role).
# Every case offers the FULL confusable registry (model_audit.TOOLSTRESS_REGISTRY, ~13 tools).
# Kinds: selection (right tool among plausible-but-wrong neighbours), nested_args (exact deep
# JSON args: enums + ISO dates + nested objects), error_recovery (canned first_error → the model
# must retry the SAME tool with corrected args), procedure (skill-like doc in the system prompt:
# ordered steps with values threaded from canned step results). Deterministic scoring only.
{"id": "ts-sel-reminder-01", "kind": "selection", "prompt": "Hoy es miércoles 15 de julio de 2026. Recuérdame tomar la pastilla de la presión mañana a las 8 de la mañana.", "expected": {"tool": "create_reminder", "required_args_subset": {"text": "pastilla", "when_iso": "2026-07-16T08:00"}, "forbidden_tools": ["create_task", "create_calendar_event", "send_notification"]}}
{"id": "ts-sel-memory-01", "kind": "selection", "prompt": "Busca en mis recuerdos qué acordamos Mariana y yo sobre el viaje a Oaxaca el mes pasado.", "expected": {"tool": "search_memory", "required_args_subset": {"query": "oaxaca"}, "forbidden_tools": ["search_web", "search_files"]}}
{"id": "ts-sel-health-01", "kind": "selection", "prompt": "Enséñame mis registros de presión arterial del 1 al 7 de julio de 2026, medición por medición, no el resumen.", "expected": {"tool": "get_health_entries", "required_args_subset": {"metric": "pressure", "date_range.from": "2026-07-01", "date_range.to": "2026-07-07"}, "forbidden_tools": ["get_health_summary", "search_memory", "export_data"]}}
{"id": "ts-sel-message-01", "kind": "selection", "prompt": "Mándale un mensaje a Karla diciéndole que llego 10 minutos tarde a la comida.", "expected": {"tool": "send_message", "required_args_subset": {"recipient": "karla", "text": "tarde"}, "forbidden_tools": ["send_notification", "create_reminder"]}}
{"id": "ts-nest-export-01", "kind": "nested_args", "prompt": "Exporta mis registros de salud (domain salud) del 1 de junio de 2026 al 30 de junio de 2026 en formato CSV.", "expected": {"tool": "export_data", "args_exact": {"format": "csv", "filters.domain": "salud", "filters.date_range.from": "2026-06-01", "filters.date_range.to": "2026-06-30"}}}
{"id": "ts-nest-config-01", "kind": "nested_args", "prompt": "En mi configuración, sección notifications, pon quiet_hours en true y quiet_hours_start en \"22:00\".", "expected": {"tool": "update_config", "args_exact": {"section": "notifications", "changes.quiet_hours": true, "changes.quiet_hours_start": "22:00"}}}
{"id": "ts-err-export-01", "kind": "error_recovery", "prompt": "Exporta mis finanzas del 1 al 13 de julio de 2026 en JSON.", "canned_tools": {"export_data": {"first_error": {"ok": false, "error": "filters.date_range requerido: agrega filters.date_range.from y filters.date_range.to en formato ISO 8601 (YYYY-MM-DD)"}, "result": {"ok": true, "file": "/exports/finanzas-2026-07.json"}}}, "expected": {"tool": "export_data", "corrected_paths": {"filters.date_range.from": "2026-07-01", "filters.date_range.to": "2026-07-13"}, "final_must_mention_any": ["export", "listo", "archivo", "json"]}}
{"id": "ts-err-event-01", "kind": "error_recovery", "prompt": "Agenda \"Dentista\" el 20 de julio de 2026 de 09:00 a 10:00 e invita a Karla.", "canned_tools": {"create_calendar_event": {"first_error": {"ok": false, "error": "end_iso requerido: agrega end_iso en formato ISO 8601"}, "result": {"ok": true, "event_id": "ev-771"}}}, "expected": {"tool": "create_calendar_event", "corrected_paths": {"end_iso": "2026-07-20T10:00", "attendees": "karla"}, "final_must_mention_any": ["dentista", "agendad", "creado", "listo"]}}
{"id": "ts-proc-expense-01", "kind": "procedure", "prompt": "Registra el gasto compartido de 450 pesos de la cena de anoche con Diego.", "procedure": "PROCEDIMIENTO — registrar un gasto compartido:\n1) Llama search_memory con el nombre de la persona para obtener su person_id.\n2) Llama create_expense con amount, category, split=true y el person_id EXACTO del paso 1.\n3) Llama send_notification (channel push) confirmando el gasto al usuario.\nSigue los pasos EN ORDEN y usa los datos que devuelva cada paso.", "canned_tools": {"search_memory": {"result": {"ok": true, "matches": [{"person": "Diego Ramos", "person_id": "p-042"}]}}, "create_expense": {"result": {"ok": true, "expense_id": "x-9001"}}}, "expected": {"steps": [{"tool": "search_memory", "args_subset": {"query": "diego"}}, {"tool": "create_expense", "args_subset": {"amount": 450, "split": true, "person_id": "p-042"}}, {"tool": "send_notification", "args_subset": {"channel": "push"}}]}}
{"id": "ts-proc-healthreport-01", "kind": "procedure", "prompt": "Prepárame el reporte mensual de salud siguiendo el procedimiento.", "procedure": "PROCEDIMIENTO — reporte mensual de salud:\n1) Llama get_health_summary con days=30; la respuesta incluye period {from, to}.\n2) Llama export_data con format=pdf y filters {domain: salud, date_range: el period EXACTO que devolvió el paso 1}.\n3) Llama send_notification (channel push) avisando que el reporte está listo.\nSigue los pasos EN ORDEN y usa los datos que devuelva cada paso.", "canned_tools": {"get_health_summary": {"result": {"ok": true, "days": 30, "period": {"from": "2026-06-15", "to": "2026-07-15"}, "pressure_avg": "128/84"}}, "export_data": {"result": {"ok": true, "file": "/exports/salud-mensual.pdf"}}}, "expected": {"steps": [{"tool": "get_health_summary", "args_subset": {"days": 30}}, {"tool": "export_data", "args_subset": {"format": "pdf", "filters.domain": "salud", "filters.date_range.from": "2026-06-15", "filters.date_range.to": "2026-07-15"}}, {"tool": "send_notification", "args_subset": {"channel": "push"}}]}}
