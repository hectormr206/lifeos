// Golden set for tool-ROUTING eval — v1
// Non-destructive sibling of tool_calling.jsonl. Tests whether Axi's brain picks
// the RIGHT tool among its three real whitelisted tools — or NO tool at all.
// Every case exposes all three: web_search, web_fetch, recall_memory.
// Format: {"id", "messages": [...], "tools": [names], "expect": {"tool": name|null,
//          "arg_substrings": {arg: [substrs]}}, "note": free}
// expect.tool == null → the model must NOT call any tool (false-call trap).
// arg_substrings are accent/case-insensitive and matched leniently (1 robust key).
//
// web_search (14) — current/verifiable world facts
{"id": "rt01", "messages": [{"role": "user", "content": "¿Cuánto vale el bitcoin ahora mismo?"}], "tools": ["web_search", "web_fetch", "recall_memory"], "expect": {"tool": "web_search", "arg_substrings": {"query": ["bitcoin"]}}, "note": "web_search: precio actual"}
{"id": "rt02", "messages": [{"role": "user", "content": "¿Cómo quedó el partido del América hoy?"}], "tools": ["web_search", "web_fetch", "recall_memory"], "expect": {"tool": "web_search", "arg_substrings": {"query": ["america"]}}, "note": "web_search: marcador deportivo"}
{"id": "rt03", "messages": [{"role": "user", "content": "¿Cómo va a estar el clima mañana en Monterrey?"}], "tools": ["web_search", "web_fetch", "recall_memory"], "expect": {"tool": "web_search", "arg_substrings": {"query": ["clima"]}}, "note": "web_search: clima"}
{"id": "rt04", "messages": [{"role": "user", "content": "¿Cuál es la última versión de Python?"}], "tools": ["web_search", "web_fetch", "recall_memory"], "expect": {"tool": "web_search", "arg_substrings": {"query": ["python"]}}, "note": "web_search: ultima version de X"}
{"id": "rt05", "messages": [{"role": "user", "content": "¿Qué noticias importantes hay hoy?"}], "tools": ["web_search", "web_fetch", "recall_memory"], "expect": {"tool": "web_search", "arg_substrings": {"query": ["noticias"]}}, "note": "web_search: noticias de hoy"}
{"id": "rt06", "messages": [{"role": "user", "content": "Busca en internet la mejor laptop para programar en 2026"}], "tools": ["web_search", "web_fetch", "recall_memory"], "expect": {"tool": "web_search", "arg_substrings": {"query": ["laptop"]}}, "note": "web_search: busca en internet"}
{"id": "rt07", "messages": [{"role": "user", "content": "¿A cómo está el dólar hoy?"}], "tools": ["web_search", "web_fetch", "recall_memory"], "expect": {"tool": "web_search", "arg_substrings": {"query": ["dolar"]}}, "note": "web_search: tipo de cambio"}
{"id": "rt08", "messages": [{"role": "user", "content": "¿Quién ganó el partido de la NBA anoche?"}], "tools": ["web_search", "web_fetch", "recall_memory"], "expect": {"tool": "web_search", "arg_substrings": {"query": ["nba"]}}, "note": "web_search: resultado reciente"}
{"id": "rt09", "messages": [{"role": "user", "content": "¿Qué películas están en cartelera este fin?"}], "tools": ["web_search", "web_fetch", "recall_memory"], "expect": {"tool": "web_search", "arg_substrings": {"query": ["cartelera"]}}, "note": "web_search: cartelera"}
{"id": "rt10", "messages": [{"role": "user", "content": "¿Cuánto cuesta la gasolina magna hoy?"}], "tools": ["web_search", "web_fetch", "recall_memory"], "expect": {"tool": "web_search", "arg_substrings": {"query": ["gasolina"]}}, "note": "web_search: precio actual"}
{"id": "rt11", "messages": [{"role": "user", "content": "Busca los resultados de las elecciones de ayer"}], "tools": ["web_search", "web_fetch", "recall_memory"], "expect": {"tool": "web_search", "arg_substrings": {"query": ["elecciones"]}}, "note": "web_search: evento reciente"}
