// Golden set for conversational-quality eval (is Axi PLEASANT to talk to?) — v1
// Judged by the prod 35B against each case's OWN rubric (model_audit.py
// conversation role), plus two deterministic judge-free checks: the reply must
// be Spanish (cpu_sweep.is_spanish) and non-empty under a sane length.
// Format: {"id", "messages": [{"role", "content"}, ...] — last turn is always
//          the user, the candidate produces the next reply,
//          "rubric": {"criteria": [{"name", "weight", "description"}]}}
// Weights per case sum to 1.0. Mix: single-turn empathy, multi-turn coherence
// (last turn references earlier context), small-talk warmth, follow-up-question
// quality, and one long-rambling-user case (concise-but-warm summarizing).
{"id": "cq01", "messages": [{"role": "user", "content": "hoy fue un día horrible en el trabajo, mi jefe me echó la culpa de algo que ni siquiera hice yo"}], "rubric": {"criteria": [{"name": "calidez", "weight": 0.35, "description": "Valida la emoción del usuario y muestra empatía genuina antes de cualquier consejo."}, {"name": "naturalidad_es", "weight": 0.25, "description": "Español natural y coloquial, sin sonar traducido ni robótico."}, {"name": "coherencia_contexto", "weight": 0.2, "description": "Responde a la situación concreta (culpa injusta del jefe), no con frases genéricas."}, {"name": "concision", "weight": 0.2, "description": "Breve y humano; no un ensayo ni una lista de 10 pasos."}]}}
{"id": "cq02", "messages": [{"role": "user", "content": "llevo como una semana durmiendo fatal, me despierto a las 3 de la mañana y ya no me vuelvo a dormir"}, {"role": "assistant", "content": "Uf, qué desgaste despertarse así todos los días. ¿Tenés idea de qué puede estar influyendo? ¿Estrés, café tarde, pantallas antes de dormir?"}, {"role": "user", "content": "puede que sea el café, me tomo como cuatro tazas al día y la última tipo 7 de la noche"}, {"role": "assistant", "content": "Cuatro tazas y la última a las 7 es bastante: la cafeína tarda horas en salir del cuerpo, así que es muy probable que sea parte del problema."}, {"role": "user", "content": "¿y entonces qué me recomiendas?"}], "rubric": {"criteria": [{"name": "coherencia_contexto", "weight": 0.4, "description": "La recomendación se ata explícitamente al café y al despertar de las 3 am mencionados antes; no ignora la conversación previa."}, {"name": "calidez", "weight": 0.2, "description": "Tono de acompañamiento, no de sermón médico."}, {"name": "naturalidad_es", "weight": 0.2, "description": "Español fluido y conversacional."}, {"name": "concision", "weight": 0.2, "description": "Una o dos recomendaciones concretas, no una lista exhaustiva."}]}}
{"id": "cq03", "messages": [{"role": "user", "content": "¡hola Axi! ¿cómo va todo? hoy amaneció un día precioso"}], "rubric": {"criteria": [{"name": "calidez", "weight": 0.4, "description": "Devuelve el saludo con energía y comparte el entusiasmo por el día."}, {"name": "naturalidad_es", "weight": 0.3, "description": "Suena como una persona cercana, no como un menú de opciones ni un asistente corporativo."}, {"name": "concision", "weight": 0.2, "description": "Charla ligera: corto, sin volcar capacidades ni ofrecer diez servicios."}, {"name": "coherencia_contexto", "weight": 0.1, "description": "Retoma el detalle del día lindo en la respuesta."}]}}
{"id": "cq04", "messages": [{"role": "user", "content": "quiero empezar a ahorrar pero la verdad no sé ni por dónde arrancar"}], "rubric": {"criteria": [{"name": "pregunta_seguimiento", "weight": 0.35, "description": "Hace UNA buena pregunta de seguimiento relevante (ingresos, meta, gastos) en vez de soltar un plan genérico completo."}, {"name": "calidez", "weight": 0.25, "description": "Anima sin juzgar la situación financiera del usuario."}, {"name": "naturalidad_es", "weight": 0.2, "description": "Español natural y cercano."}, {"name": "concision", "weight": 0.2, "description": "No abruma: nada de listas largas de consejos en el primer mensaje."}]}}
{"id": "cq05", "messages": [{"role": "user", "content": "a ver te cuento porque traigo la cabeza hecha bolas, resulta que esta semana tengo la entrega del proyecto el jueves y todavía no termino la parte de los reportes, aparte quedé de ir al gimnasio lunes miércoles y viernes porque ya pagué el mes completo y me da coraje desperdiciarlo, y el sábado es la cena de aniversario de mis papás que me toca organizar a mí y no he reservado restaurante, y encima ando checando la tarjeta porque se me juntaron los pagos y no sé si me alcanza para todo, ¿tú qué ves?"}], "rubric": {"criteria": [{"name": "concision", "weight": 0.35, "description": "Resume el enredo en pocas líneas y prioriza (entrega, reserva, dinero) sin repetir todo lo que dijo el usuario."}, {"name": "coherencia_contexto", "weight": 0.25, "description": "Recoge los cuatro frentes (proyecto, gimnasio, cena, tarjeta) sin inventar otros."}, {"name": "calidez", "weight": 0.25, "description": "Baja la ansiedad: tono tranquilizador, no otra lista abrumadora."}, {"name": "naturalidad_es", "weight": 0.15, "description": "Español fluido, coloquial mexicano/neutro."}]}}
{"id": "cq06", "messages": [{"role": "user", "content": "el sábado vienen mis papás a cenar a la casa y quiero cocinar algo especial"}, {"role": "assistant", "content": "¡Qué buen plan! ¿Tenés algo en mente o querés ideas? ¿Hay alguna restricción de comida que deba saber?"}, {"role": "user", "content": "mi papá es diabético, entonces nada con mucha azúcar... ¿qué me sugieres de postre?"}], "rubric": {"criteria": [{"name": "coherencia_contexto", "weight": 0.4, "description": "El postre sugerido respeta explícitamente la diabetes del papá mencionada en el turno anterior."}, {"name": "calidez", "weight": 0.2, "description": "Mantiene el entusiasmo por la cena familiar."}, {"name": "naturalidad_es", "weight": 0.2, "description": "Español natural de conversación de cocina."}, {"name": "concision", "weight": 0.2, "description": "Una o dos sugerencias concretas, no un recetario."}]}}
{"id": "cq07", "messages": [{"role": "user", "content": "¡¡me dieron el aumento que llevaba meses pidiendo!! todavía no me lo creo"}], "rubric": {"criteria": [{"name": "calidez", "weight": 0.4, "description": "Celebra con entusiasmo genuino y reconoce el esfuerzo de meses del usuario."}, {"name": "naturalidad_es", "weight": 0.25, "description": "La celebración suena humana y espontánea, no formulaica."}, {"name": "coherencia_contexto", "weight": 0.15, "description": "Habla del aumento y de lo que costó conseguirlo, sin desviarse a consejos no pedidos."}, {"name": "concision", "weight": 0.2, "description": "Festejo breve; no convierte la buena noticia en plan financiero."}]}}
{"id": "cq08", "messages": [{"role": "user", "content": "oye, apunta que soy alérgico a las nueces por favor, es importante"}, {"role": "assistant", "content": "¡Anotado! Alergia a las nueces, lo tendré siempre presente cuando hablemos de comida."}, {"role": "user", "content": "gracias :) oye, para el cumple de mi novia quiero prepararle un postre yo mismo, ¿qué me recomiendas?"}, {"role": "assistant", "content": "¡Qué lindo detalle hacerlo vos mismo! ¿Ella tiene algún sabor favorito, o vamos a lo seguro?"}, {"role": "user", "content": "le encanta el chocolate, ¿qué opción me queda bien?"}], "rubric": {"criteria": [{"name": "coherencia_contexto", "weight": 0.45, "description": "La recomendación es de chocolate Y evita o advierte sobre las nueces por la alergia declarada varios turnos atrás (brownies con nuez sería un fallo grave)."}, {"name": "calidez", "weight": 0.2, "description": "Acompaña la ilusión del regalo hecho a mano."}, {"name": "naturalidad_es", "weight": 0.15, "description": "Español conversacional fluido."}, {"name": "concision", "weight": 0.2, "description": "Una recomendación concreta y ejecutable, no cinco recetas."}]}}
