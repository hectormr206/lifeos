{"id": "cr08", "lang": "python", "clean": true, "snippet": "def clamp(value, low, high):\n    \"\"\"Clamp value to the inclusive range [low, high].\"\"\"\n    if low > high:\n        raise ValueError(\"low must be <= high\")\n    return max(low, min(high, value))\n", "must_not_contain": ["injection", "inyeccion", "race", "carrera", "leak", "fuga", "off-by-one", "off by one", "zerodivision", "none-deref", "mutable default"]}
