# tool_stress v2 DRAFTS — HARDER MCP-protocol robustness (NOT production).
# Saturation: 8/16 finalists >=0.95 on v1. The FULL TOOLSTRESS_REGISTRY (~13 tools)
# is offered every round. These raise difficulty per kind:
#   selection    -> tighter confusable neighbours (task vs reminder vs calendar; no date given)
#   nested_args  -> boolean + int coercion in a deep changes{} object; full-year date range
#   error_recovery -> ENUM correction (wrong metric string) recovered on retry
#   procedure    -> FOUR ordered steps threading a value returned by step 1
# Schema IDENTICAL to live set. Rounds must stay <= TOOLSTRESS_MAX_ROUNDS (~6).
# Target top model ~0.80-0.90.
{"id": "ts-v2-sel-01", "v2_draft": true, "kind": "selection", "prompt": "Anótame que tengo que terminar la propuesta para el cliente; es de prioridad alta y no tiene fecha fija todavía.", "expected": {"tool": "create_task", "required_args_subset": {"title": "propuesta", "priority": "high"}, "forbidden_tools": ["create_reminder", "create_calendar_event", "send_notification"]}, "note": "no date + 'prioridad alta' => create_task, NOT create_reminder/create_calendar_event"}
{"id": "ts-v2-nest-01", "v2_draft": true, "kind": "nested_args", "prompt": "En mi configuración, sección privacy, desactiva el share_analytics (ponlo en false) y fija retention_days en 90.", "expected": {"tool": "update_config", "args_exact": {"section": "privacy", "changes.share_analytics": false, "changes.retention_days": 90}}, "note": "coercion: JSON boolean false (not the string 'false') AND integer 90 (not '90') inside changes{}"}
{"id": "ts-v2-nest-02", "v2_draft": true, "kind": "nested_args", "prompt": "Exporta TODAS mis finanzas del año completo 2026 (del 1 de enero al 31 de diciembre de 2026) en formato PDF.", "expected": {"tool": "export_data", "args_exact": {"format": "pdf", "filters.domain": "finanzas", "filters.date_range.from": "2026-01-01", "filters.date_range.to": "2026-12-31"}}, "note": "full-year ISO range + pdf enum; deep nested filters.date_range"}
{"id": "ts-v2-err-01", "v2_draft": true, "kind": "error_recovery", "prompt": "Enséñame mis registros de presión arterial del 1 al 7 de julio de 2026, medición por medición.", "canned_tools": {"get_health_entries": {"first_error": {"ok": false, "error": "metric inválido 'presion': usa uno de pressure | pulse | weight | sleep"}, "result": {"ok": true, "entries": [{"date": "2026-07-01", "value": "119/78"}]}}}, "expected": {"tool": "get_health_entries", "corrected_paths": {"metric": "pressure", "date_range.from": "2026-07-01", "date_range.to": "2026-07-07"}, "final_must_mention_any": ["presion", "119", "registro", "medicion"]}, "note": "enum recovery: model first sends metric='presion' (Spanish), must retry with the canonical enum 'pressure'"}
{"id": "ts-v2-proc-01", "v2_draft": true, "kind": "procedure", "prompt": "Comparte el reporte de gastos del mes con mi contador siguiendo el procedimiento.", "procedure": "PROCEDIMIENTO — compartir el reporte de gastos:\n1) Llama search_memory con 'contador' para obtener su person_id.\n2) Llama export_data con format=csv y filters {domain: finanzas, date_range: {from: 2026-07-01, to: 2026-07-31}}.\n3) Llama send_message al contador (recipient = el person_id EXACTO del paso 1) avisando que el archivo está listo.\n4) Llama send_notification (channel push) confirmándome a MÍ que ya se compartió.\nSigue los pasos EN ORDEN y usa los datos que devuelva cada paso.", "canned_tools": {"search_memory": {"result": {"ok": true, "matches": [{"person": "Contador Ortega", "person_id": "p-311"}]}}, "export_data": {"result": {"ok": true, "file": "/exports/gastos-julio.csv"}}, "send_message": {"result": {"ok": true, "message_id": "m-88"}}}, "expected": {"steps": [{"tool": "search_memory", "args_subset": {"query": "contador"}}, {"tool": "export_data", "args_subset": {"format": "csv", "filters.domain": "finanzas", "filters.date_range.from": "2026-07-01", "filters.date_range.to": "2026-07-31"}}, {"tool": "send_message", "args_subset": {"recipient": "p-311"}}, {"tool": "send_notification", "args_subset": {"channel": "push"}}], "note": "4 ordered steps; step 3 recipient must be threaded from the person_id returned by step 1"}}
