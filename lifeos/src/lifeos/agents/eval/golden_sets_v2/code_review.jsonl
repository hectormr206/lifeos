{"id": "cr-v2-01", "lang": "python", "bug": "off-by-one-1based-pagination", "clean": false, "v2_draft": true, "snippet": "def paginate(items, page_num, per_page):\n    # page_num is 1-based: page 1 is the first page\n    start = page_num * per_page\n    return items[start:start + per_page]\n", "must_contain": [["off-by-one", "off by one", "page_num - 1", "(page_num-1)", "1-based", "primera pagina", "skips the first"]]}
