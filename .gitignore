# LifeOS umbrella — runtime/local-only paths
# Per-product gitignores live inside each product (e.g. axi/.gitignore)

# Common editor/OS noise
.DS_Store
*.swp
*~
.idea/
.vscode/

# Python bytecode (keeps Axi-built modules at the repo root clean on deploy)
__pycache__/
*.pyc

# SDD tooling (machine-specific absolute paths, regenerable via sdd-init)
.atl/

# Funding workspace — grant correspondence stays local-only
docs/funding/

.pi/

# CodeGraph — local code-index (SQLite graph), machine-specific
.codegraph/

# openapi-generator-cli config written at repo root by npx during client gen
/openapitools.json

# OTA publish secrets (never commit)
mobile/tools/ota-publish.env

# Backup-host access key (never commit)
backup-host/backup-host.env
