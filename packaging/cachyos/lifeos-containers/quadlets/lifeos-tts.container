# lifeos-tts.container — user-scope Quadlet for CachyOS packaging
#
# T19: Adapted from containers/lifeos-tts/ for rootless user-scope.
# Installed to /usr/share/lifeos/quadlets/ by lifeos-containers PKGBUILD.
# Linked into ~/.config/containers/systemd/ by lifeos-quadlet-install --user.
#
# Verification (after install + daemon-reload):
#   systemctl --user status lifeos-tts.service
#   curl -s http://127.0.0.1:8084/health
#   curl -s http://127.0.0.1:8084/voices
#
# Port: 8084 (lifeosd uses http://127.0.0.1:8084 for TTS synthesis).
# Model: Kokoro-82M (Apache 2.0), baked into the container image — no bind mount needed.

[Unit]
Description=LifeOS Kokoro TTS Server (user-scope)
Documentation=https://github.com/hexgrad/kokoro
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/hectormr206/lifeos-tts:stable
AutoUpdate=registry
ContainerName=lifeos-tts
HostName=lifeos-tts

PublishPort=127.0.0.1:8084:8084

# TTS env file: voice selection, quality settings.
# Quadlet EnvironmentFile= translates to podman --env-file — vars are injected
# into the container process env without needing a bind mount.
EnvironmentFile=/etc/lifeos/tts-server.env

# Bind on 0.0.0.0 inside the container so PublishPort can forward correctly.
Environment=LIFEOS_TTS_ENGINE_HOST=0.0.0.0

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=60s
MemoryMax=1536M
CPUQuota=200%

[Install]
WantedBy=default.target
