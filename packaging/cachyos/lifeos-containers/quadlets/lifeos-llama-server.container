# lifeos-llama-server.container — user-scope Quadlet for CachyOS packaging
#
# T19: Adapted from containers/lifeos-llama-server/ for rootless user-scope.
# Installed to /usr/share/lifeos/quadlets/ by lifeos-containers PKGBUILD.
# Linked into ~/.config/containers/systemd/ by lifeos-quadlet-install --user.
#
# Verification (after install + daemon-reload):
#   systemctl --user status lifeos-llama-server.service
#   curl -s http://127.0.0.1:8082/health
#
# Port: 8082 (lifeosd reads from this port — must not change).
# GPU: CDI device injection via AddDevice=nvidia.com/gpu=all.
#   Requires /etc/cdi/nvidia.yaml (run: sudo nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml).

[Unit]
Description=LifeOS LLM Server (Qwen3.5 CUDA, user-scope)
Documentation=https://github.com/ggml-org/llama.cpp
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/hectormr206/lifeos-llama-server:stable
AutoUpdate=registry
ContainerName=lifeos-llama-server
HostName=lifeos-llama-server

# Port binding: rootless podman maps host loopback → container port.
# lifeosd uses http://127.0.0.1:8082 unchanged.
PublishPort=127.0.0.1:8082:8082

# GPU passthrough via CDI (Container Device Interface).
# Requires /etc/cdi/nvidia.yaml — generated by:
#   sudo nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml
# Refresh on driver update is handled by lifeos-cdi-refresh.path (PR-4).
AddDevice=nvidia.com/gpu=all

# Models bind mount — read-only. Survives container recreation.
# ':z' (shared MCS label) allows multiple containers to read the same dir.
Volume=/var/lib/lifeos/models:/var/lib/lifeos/models:ro,z

# Exec: model and tuning params come from the runtime profile env file,
# written by the benchmarker or game-guard. Uses bash -c + ${VAR:+$VAR}
# to correctly handle empty optional flags (empty string = 0 tokens, not
# a literal empty argv entry that confuses llama-server argument parsing).
Exec=/bin/bash -c 'exec /usr/sbin/llama-server \
    --model /var/lib/lifeos/models/${LIFEOS_AI_MODEL} \
    --mmproj /var/lib/lifeos/models/${LIFEOS_AI_MMPROJ} \
    --alias lifeos \
    --host 0.0.0.0 \
    --port 8082 \
    --ctx-size ${LIFEOS_AI_CTX_SIZE} \
    --threads ${LIFEOS_AI_THREADS} \
    --n-gpu-layers ${LIFEOS_AI_GPU_LAYERS} \
    --mlock \
    --parallel ${LIFEOS_AI_PARALLEL} \
    --batch-size ${LIFEOS_AI_BATCH_SIZE} \
    --ubatch-size ${LIFEOS_AI_UBATCH_SIZE} \
    --n-predict 2048 \
    -kvu -cram -1 \
    --cache-type-k q8_0 \
    --cache-type-v q8_0 \
    ${LIFEOS_AI_DEVICE_FLAGS:+$LIFEOS_AI_DEVICE_FLAGS} \
    ${LIFEOS_AI_GPU_TUNING:+$LIFEOS_AI_GPU_TUNING} \
    --temp 0.6 --top-p 0.95 --top-k 20 --min-p 0.0 \
    --presence-penalty 0.0 --repeat-penalty 1.0 \
    --reasoning off \
    --jinja'

[Service]
# Wait up to 60s for the CDI spec before starting. Polls without blocking.
ExecStartPre=-/bin/bash -c 'i=0; while [ $i -lt 60 ]; do for f in /run/cdi/nvidia.yaml /var/run/cdi/nvidia.yaml /etc/cdi/nvidia.yaml; do [ -s "$f" ] && exit 0; done; sleep 1; i=$((i+1)); done; exit 0'

# Wait up to 90s for lifeosd to write LIFEOS_AI_MODEL into the runtime profile.
ExecStartPre=-/bin/bash -c 'i=0; while [ $i -lt 90 ]; do f=/var/lib/lifeos/llama-server-runtime-profile.env; if [ -s "$f" ] && grep -q "^LIFEOS_AI_MODEL=" "$f"; then exit 0; fi; sleep 1; i=$((i+1)); done; echo "WARN: LIFEOS_AI_MODEL not set after 90s — starting anyway"; exit 0'

# Host-side env files — systemd reads these before creating the container.
EnvironmentFile=-/var/lib/lifeos/llama-server-runtime-profile.env
EnvironmentFile=-/var/lib/lifeos/llama-server-game-guard.env

Restart=always
RestartSec=15s
TimeoutStartSec=180s
MemoryMax=8G
CPUQuota=400%

[Install]
WantedBy=default.target
