#!/usr/bin/env bash
# Game Guard: relocate models from GPU to CPU/RAM so games get all the
# VRAM. Axi stays functional (voice commands, brain answers) — just
# slower. Reverse with `axi-game-off`.
#
# What moves:
#   llama-server (Qwen)   GPU → CPU (-ngl 0). Frees ~7.8 GB VRAM.
#   axi-voice (Whisper)   GPU → CPU (int8). Frees ~2.2 GB VRAM.
#   axi-translate         Stopped if active (interpreter mode is
#                         incompatible with gaming anyway).
#
# Total VRAM reclaimed: ~10 GB. The tray icon stays alive throughout.

set -u

DROPIN_DIR_LLAMA=~/.config/systemd/user/llama-server.service.d
DROPIN_DIR_VOICE=~/.config/systemd/user/axi-voice.service.d
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/axi"
MARKER="$STATE_DIR/game-mode.lock"
mkdir -p "$STATE_DIR"
touch "$MARKER"

echo "[axi-game-on] stopping axi-translate (if active)…"
systemctl --user stop axi-translate.service 2>/dev/null || true

echo "[axi-game-on] moving llama-server to CPU (-ngl 0)…"
mkdir -p "$DROPIN_DIR_LLAMA"
cat > "$DROPIN_DIR_LLAMA/cpu-exec.conf" <<'EOF'
[Service]
ExecStart=
ExecStart=/usr/bin/llama-server \
  -m %h/LifeOS/models/Qwen3.6-35B-A3B/Qwen3.6-35B-A3B-MXFP4_MOE.gguf \
  --mmproj %h/LifeOS/models/Qwen3.6-35B-A3B/mmproj-BF16.gguf \
  -ngl 0 \
  --jinja \
  -c 32768 \
  --reasoning-format auto \
  --cache-type-k q8_0 \
  --cache-type-v q8_0 \
  -t 24 \
  -tb 24 \
  --temp 0.6 \
  --top-p 0.95 \
  --top-k 20 \
  --host 127.0.0.1 \
  --port 8080 \
  -np 1 \
  --no-mmap \
  -a Qwen3.6-35B-A3B
EOF

echo "[axi-game-on] moving axi-voice (Whisper) to CPU…"
mkdir -p "$DROPIN_DIR_VOICE"
cat > "$DROPIN_DIR_VOICE/cpu-env.conf" <<'EOF'
[Service]
Environment="AXI_WHISPER_DEVICE=cpu"
Environment="AXI_WHISPER_COMPUTE_TYPE=int8"
EOF

systemctl --user daemon-reload
systemctl --user restart llama-server.service
systemctl --user restart axi-voice.service

# Give CUDA a moment to release.
sleep 2

if command -v nvidia-smi >/dev/null 2>&1; then
    USED=$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits)
    TOTAL=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits)
    echo "[axi-game-on] GPU VRAM: ${USED} / ${TOTAL} MiB usado"
fi

echo "[axi-game-on] modo juego ACTIVO."
echo "  Axi sigue funcional pero más lento (voz + Qwen en CPU)."
echo "  Para volver a GPU: axi-game-off"
