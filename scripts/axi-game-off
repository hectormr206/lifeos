#!/usr/bin/env bash
# Restore the GPU-backed axi stack after a gaming session.

set -u

DROPIN_DIR_LLAMA=~/.config/systemd/user/llama-server.service.d
DROPIN_DIR_VOICE=~/.config/systemd/user/axi-voice.service.d
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/axi"
MARKER="$STATE_DIR/game-mode.lock"
rm -f "$MARKER"

echo "[axi-game-off] removing CPU drop-ins…"
rm -f "$DROPIN_DIR_LLAMA"/cpu-exec.conf
rm -f "$DROPIN_DIR_LLAMA"/cpu-override.conf
rmdir "$DROPIN_DIR_LLAMA" 2>/dev/null || true
rm -f "$DROPIN_DIR_VOICE"/cpu-env.conf
rmdir "$DROPIN_DIR_VOICE" 2>/dev/null || true

systemctl --user daemon-reload

echo "[axi-game-off] restarting llama-server (back to GPU)…"
systemctl --user restart llama-server.service

echo "[axi-game-off] waiting for llama-server /health…"
for i in $(seq 1 30); do
    if curl -sf http://127.0.0.1:8080/health >/dev/null 2>&1; then
        echo "[axi-game-off] llama-server ready"
        break
    fi
    sleep 1
done

echo "[axi-game-off] restarting axi-voice (Whisper back to GPU)…"
systemctl --user restart axi-voice.service

if command -v nvidia-smi >/dev/null 2>&1; then
    sleep 2
    USED=$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits)
    TOTAL=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits)
    echo "[axi-game-off] GPU VRAM: ${USED} / ${TOTAL} MiB usado"
fi

echo "[axi-game-off] axi restaurado a velocidad GPU normal."
