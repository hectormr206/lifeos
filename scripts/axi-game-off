#!/usr/bin/env bash
# Restore the GPU-backed axi stack after a gaming session.
# Starts llama-server (Qwen, GPU) and axi-voice (Whisper, GPU).

set -u

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/axi"
MARKER="$STATE_DIR/game-mode.lock"
rm -f "$MARKER"

# Safety: ensure no leftover CPU drop-in is biasing the restart.
rm -f ~/.config/systemd/user/llama-server.service.d/cpu-exec.conf
rm -f ~/.config/systemd/user/llama-server.service.d/cpu-override.conf
rm -f ~/.config/systemd/user/axi-voice.service.d/cpu-env.conf
rmdir ~/.config/systemd/user/llama-server.service.d 2>/dev/null || true
rmdir ~/.config/systemd/user/axi-voice.service.d 2>/dev/null || true
systemctl --user daemon-reload

echo "[axi-game-off] starting llama-server (Qwen → GPU)…"
systemctl --user start llama-server.service || true

echo "[axi-game-off] waiting for llama-server /health…"
for i in $(seq 1 30); do
    if curl -sf http://127.0.0.1:8080/health >/dev/null 2>&1; then
        echo "[axi-game-off] llama-server ready"
        break
    fi
    sleep 1
done

echo "[axi-game-off] starting axi-voice (Whisper → GPU)…"
systemctl --user start axi-voice.service || true

if command -v nvidia-smi >/dev/null 2>&1; then
    sleep 2
    USED=$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits)
    TOTAL=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits)
    echo "[axi-game-off] GPU VRAM: ${USED} / ${TOTAL} MiB usado"
fi

echo "[axi-game-off] axi restaurado."
