[Unit]
Description=llama.cpp server — Axi brain (Qwen3.6-35B-A3B MXFP4 MoE, vision)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Listen only on localhost so the model is not exposed on the network.
# Adapted from the YouTuber config used as reference; ported to Linux paths,
# Intel i9-13900HX core layout (P-cores 0-15), and Hector's filesystem.
ExecStart=/usr/bin/llama-server \
  -m %h/LifeOS/models/Qwen3.6-35B-A3B/Qwen3.6-35B-A3B-MXFP4_MOE.gguf \
  --mmproj %h/LifeOS/models/Qwen3.6-35B-A3B/mmproj-BF16.gguf \
  -ngl 999 \
  --cpu-moe \
  --prio 3 \
  --prio-batch 3 \
  --poll 100 \
  --poll-batch 1 \
  -Cr 0-15 \
  -Crb 0-15 \
  --cpu-strict 1 \
  --cpu-strict-batch 1 \
  --jinja \
  -c 32768 \
  --reasoning-format auto \
  --cache-type-k q8_0 \
  --cache-type-v q8_0 \
  -fa on \
  -b 8192 \
  -ub 4096 \
  -t 8 \
  -tb 16 \
  --temp 0.6 \
  --top-p 0.95 \
  --top-k 20 \
  --min-p 0.0 \
  --presence-penalty 0.0 \
  --repeat-penalty 1.0 \
  --host 127.0.0.1 \
  --port 8080 \
  -np 1 \
  --no-mmap \
  --mlock \
  --image-min-tokens 1024 \
  -a Qwen3.6-35B-A3B
Restart=on-failure
RestartSec=5
# Allow up to 60s for first-load (loading 22GB from disk takes a moment).
TimeoutStartSec=120
# --mlock needs the ability to lock the full 22GB of model into RAM.
LimitMEMLOCK=infinity

[Install]
WantedBy=default.target
