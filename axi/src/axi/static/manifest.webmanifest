{
  "name": "Axi",
  "short_name": "Axi",
  "description": "Tu asistente personal de IA local-first",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0e1116",
  "theme_color": "#cc66ff",
  "icons": [
    {"src": "/static/axi-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "/static/axi-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "/static/axi-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {"name": "files", "accept": ["image/*", "text/*"]}
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Chat",
      "short_name": "Chat",
      "url": "/chat",
      "icons": [{"src": "/static/axi-192.png", "sizes": "192x192"}]
    },
    {
      "name": "Recordatorios",
      "short_name": "Reminders",
      "url": "/reminders",
      "icons": [{"src": "/static/axi-192.png", "sizes": "192x192"}]
    },
    {
      "name": "Calendario",
      "short_name": "Calendar",
      "url": "/calendar",
      "icons": [{"src": "/static/axi-192.png", "sizes": "192x192"}]
    }
  ]
}
