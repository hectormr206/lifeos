[Unit]
Description=Axi interpreter mode (EN→ES real-time translation)
After=graphical-session.target sound.target axi-whisper.service
Wants=axi-whisper.service
PartOf=graphical-session.target
# Note: voice and translate can now run concurrently because both share a
# single Whisper instance through axi-whisper.service (~1.6 GB instead of
# 2× ~2.3 GB). The activation scripts no longer need to stop axi-voice.

[Service]
Type=simple
ExecStart=%h/LifeOS/lifeos/axi/.venv/bin/python -m axi.translate
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
