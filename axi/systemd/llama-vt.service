[Unit]
Description=llama.cpp server — VibeThinker-3B reasoning (model from active_vt_model.json via axi-vt-launch)
After=graphical-session.target
# Intentionally NOT PartOf=graphical-session.target: that coupling made the GPU
# brains cascade-stop during systemd transactions (the "gremlin"). Enabled
# (WantedBy=default.target) + After= gives boot ordering without the cascade.

[Service]
Type=simple
# GPU-RESIDENT: VibeThinker-3B runs fully on GPU (ngl=999).
# Unlike llama-nano.service, we do NOT set CUDA_VISIBLE_DEVICES="" here —
# that would hide the GPU and defeat the purpose of a 60K-context reasoning
# brain. The GPU is shared with llama-server.service (port 8080); the total
# measured VRAM is ~8.68 GB for both brains at 60K ctx each.
#
# LIFECYCLE is managed by the application layer (dashboard activate +
# game scripts), NOT by systemd BindsTo/PartOf coupling to llama-server.
# This mirrors the llama-nano.service independent-sibling design.
#
# axi-vt-launch reads $XDG_STATE_HOME/axi/active_vt_model.json (created on
# first launch with VibeThinker-3B defaults) and execs llama-server on
# port 8082 with the assembled args.
#
# ENABLE vs LINK: this unit is `enabled` (not just `linked`) so that
# WantedBy=default.target creates a real symlink and systemd keeps it
# anchored during sibling-restart transactions (the original "drop gremlin").
#
# BOOT-TIME OOM GUARD: enabling means llama-vt auto-starts at boot.
# If the active primary brain at boot is the 35B (qwen36-35b-a3b), then
# llama-server (22 GB) + llama-vt (3.3 GB) both load → 25+ GB on a 12 GB
# GPU → OOM. ExecCondition runs axi-vt-guard which exits 0 only when the
# active primary is qwen35-4b (the triad configuration). A non-zero exit
# from ExecCondition causes systemd to skip the unit cleanly (not a failure).
ExecCondition=%h/LifeOS/lifeos/axi/scripts/axi-vt-guard
ExecStart=%h/LifeOS/lifeos/axi/scripts/axi-vt-launch
Restart=on-failure
RestartSec=5
TimeoutStartSec=60

[Install]
WantedBy=default.target
