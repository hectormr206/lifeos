[Unit]
Description=llama.cpp server — Axi brain (model from active_model.json via axi-llama-launch)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Listen only on localhost so the model is not exposed on the network.
# The wrapper reads $XDG_STATE_HOME/axi/active_model.json (created on first
# launch with the historical Qwen3.6-35B-A3B defaults) and execs llama-server
# with the assembled argv. Game-guard drops in `--cpu` via cpu-exec.conf.
ExecStart=%h/LifeOS/lifeos/axi/scripts/axi-llama-launch
Restart=on-failure
RestartSec=5
# Allow up to 60s for first-load (loading 22GB from disk takes a moment).
TimeoutStartSec=120
# --mlock needs the ability to lock the full 22GB of model into RAM.
LimitMEMLOCK=infinity

[Install]
WantedBy=default.target
