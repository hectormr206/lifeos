[Unit]
Description=llama.cpp server — nano-agents (Qwen3.5-0.8B on port 8090)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Listens only on localhost. CPU-ONLY. -ngl 0 alone wasn't enough: the
# llama.cpp-cuda build still initialized a CUDA context (~900 MiB VRAM
# reserved for the runtime) even with zero offloaded layers.
# CUDA_VISIBLE_DEVICES="" hides the GPU completely from the process so
# llama-server can never touch VRAM regardless of flags.
# The main brain (port 8080) keeps its full GPU access — they don't share.
Environment="CUDA_VISIBLE_DEVICES="
ExecStart=/usr/bin/llama-server \
  -m %h/LifeOS/models/qwen35-0_8b/Qwen3.5-0.8B-Q4_K_M.gguf \
  --port 8090 --host 127.0.0.1 \
  -c 4096 -ngl 0 --jinja \
  -t 4 --no-mmap -np 1 \
  -a Qwen3.5-0.8B-nano
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
# 1.5GB RAM cap — model + cache fits in this.
MemoryMax=2G

[Install]
WantedBy=default.target
