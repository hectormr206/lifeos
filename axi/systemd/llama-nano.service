[Unit]
Description=llama.cpp server — nano-agents (model from active_nano_model.json via axi-nano-launch)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Listens only on localhost. CPU-ONLY. -ngl 0 alone wasn't enough: the
# llama.cpp-cuda build still initialized a CUDA context (~900 MiB VRAM
# reserved for the runtime) even with zero offloaded layers.
# CUDA_VISIBLE_DEVICES="" hides the GPU completely from the process so
# llama-server can never touch VRAM regardless of flags.
# The main brain (port 8080) keeps its full GPU access — they don't share.
# The wrapper reads $XDG_STATE_HOME/axi/active_nano_model.json (created on
# first launch with the historical Qwen3.5-0.8B defaults) and execs
# llama-server with the assembled args.
Environment="CUDA_VISIBLE_DEVICES="
ExecStart=%h/LifeOS/lifeos/axi/scripts/axi-nano-launch
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
# 2 GB RAM cap — largest nano model (LFM2 1.2B) + KV cache fits here.
MemoryMax=2G

[Install]
WantedBy=default.target
