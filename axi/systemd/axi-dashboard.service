[Unit]
Description=Axi local dashboard (FastAPI + uvicorn)
After=graphical-session.target axi-voice.service
PartOf=graphical-session.target
Wants=axi-voice.service

[Service]
Type=simple
# HF_TOKEN for authenticated huggingface_hub downloads from the model
# selector. Without this, HF throttles unauthenticated traffic heavily
# (slow + rate-limited). .env is gitignored so the token stays local.
EnvironmentFile=-%h/LifeOS/lifeos/axi/.env
ExecStart=%h/LifeOS/lifeos/axi/.venv/bin/python -m axi.dashboard
Restart=on-failure
RestartSec=3
# Listen only on localhost — never expose the dashboard to the network.

[Install]
WantedBy=default.target
