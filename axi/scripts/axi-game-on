#!/usr/bin/env bash
# Game Guard (total): free ALL GPU VRAM for demanding games by stopping
# every axi service that holds a CUDA context. Unlike a "CPU-relocate"
# approach, this also reclaims the ~2.4 GB of CUDA context overhead that
# stays loaded as long as a CUDA-using process lives. Reverse with
# `axi-game-off`.
#
# Tradeoff: Axi is OFFLINE during gaming. You cannot talk to it, brain
# does not answer, voice does not work. Use this when you need 100% of
# VRAM for the game (RE Requiem, Cyberpunk RT, etc.).
#
# VRAM freed on the RTX 5070 Ti (12 GB):
#   axi-translate (if active): ~2.3 GB
#   axi-voice (Whisper):       ~2.2 GB
#   llama-server (Qwen):       ~7.8 GB
#   Total reclaimed:           ~10–12 GB (effectively all of it).
#
# The tray icon stays alive (Wants=, not Requires=).

set -u

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/axi"
MARKER="$STATE_DIR/game-mode.lock"
mkdir -p "$STATE_DIR"
touch "$MARKER"

# Clean any CPU-mode drop-ins from prior runs / interpreter mode so the
# next axi-game-off restart restores the normal GPU configuration.
rm -f ~/.config/systemd/user/llama-server.service.d/cpu-exec.conf
rm -f ~/.config/systemd/user/llama-server.service.d/cpu-override.conf
rm -f ~/.config/systemd/user/axi-voice.service.d/cpu-env.conf
rmdir ~/.config/systemd/user/llama-server.service.d 2>/dev/null || true
rmdir ~/.config/systemd/user/axi-voice.service.d 2>/dev/null || true
systemctl --user daemon-reload

echo "[axi-game-on] stopping axi-translate (if active)…"
systemctl --user stop axi-translate.service 2>/dev/null || true

echo "[axi-game-on] stopping axi-voice (releases Whisper + CUDA ctx)…"
systemctl --user stop axi-voice.service 2>/dev/null || true

echo "[axi-game-on] stopping llama-server (releases Qwen + CUDA ctx)…"
systemctl --user stop llama-server.service 2>/dev/null || true

# Give the kernel a moment to actually release the GPU memory.
sleep 1

if command -v nvidia-smi >/dev/null 2>&1; then
    USED=$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits)
    TOTAL=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits)
    echo "[axi-game-on] GPU VRAM: ${USED} / ${TOTAL} MiB usado"
fi

echo "[axi-game-on] MODO JUEGO TOTAL activo — toda la VRAM es tuya."
echo "  Axi está OFFLINE durante el juego (no responde voz ni cerebro)."
echo "  Para volver:  axi-game-off"
