#!/usr/bin/env bash
# Game Mode — free ALL GPU VRAM for demanding games.
#
# DEFAULT (relocate / co-pilot mode):
#   Swaps the active brain to qwen35-2b on CPU (~2.2 GB RAM, 10 s/frame).
#   The game owns all 12 GB VRAM; a fast, light Qwen co-pilot stays available
#   in RAM. The previous brain id is saved to $STATE_DIR/game-pre-model so
#   axi-game-off can restore it exactly.
#
# --offline (max-FPS, no co-pilot):
#   Stops llama-server entirely (zero CPU for LLM during game). Still saves
#   game-pre-model for restore. Whisper and translate still relocate to CPU.
#
# Why drop-ins instead of `stop`: the drop-in files under
# ~/.config/systemd/user/<svc>.service.d/ PERSIST across reboot/shutdown.
# If you leave game mode active and reboot, systemd starts each service
# already pinned to CPU, so NOTHING loads into VRAM until `axi-game-off`
# removes the drop-ins. The game-mode.lock marker is the on/off source of
# truth; the drop-ins do the actual relocation.
#
# Usage:
#   axi-game-on             # load qwen35-2b co-pilot on CPU; VRAM free
#   axi-game-on --offline   # max-FPS: stop co-pilot entirely (0 CPU for LLM)
#
# VRAM holders on the RTX 5070 Ti (12 GB) and where they go in game mode:
#   axi-whisper  (Whisper large-v3-turbo): ~2.3 GB VRAM  -> RAM (int8, CPU)
#   llama-server (co-pilot qwen35-2b):     ~0 VRAM        -> RAM (--cpu, ngl=0)
#   axi-translate (Opus/NLLB):             already CPU by default
#   Result: ~0 MiB VRAM used by axi (effectively all 12 GB free for the game).

set -u

OFFLINE=0
[ "${1:-}" = "--offline" ] && OFFLINE=1

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/axi"
MARKER="$STATE_DIR/game-mode.lock"
PRE_MODEL_FILE="$STATE_DIR/game-pre-model"
UNIT_DIR="$HOME/.config/systemd/user"
# Python interpreter used by axi scripts.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
AXI_PYTHON="$SCRIPT_DIR/../.venv/bin/python"
mkdir -p "$STATE_DIR"

# Guard: if a backup already exists, game-on was already run; do NOT clobber it.
if [ -f "$PRE_MODEL_FILE" ]; then
    echo "[axi-game-on] WARNING: game-pre-model already exists — game-on may have been run twice."
    echo "  Skipping model backup to avoid clobbering the original brain id."
    echo "  Run 'axi-game-off' first if you want to reset."
else
    # Capture the current active model id before swapping.
    # Fail loudly if AXI_PYTHON is missing so we don't silently write an empty backup.
    if ! PREV_MODEL=$("$AXI_PYTHON" -m axi.models_manager get-active 2>&1); then
        echo "[axi-game-on] ERROR: could not read active model via '$AXI_PYTHON' — aborting." >&2
        exit 1
    fi
    printf '%s\n' "${PREV_MODEL:-}" > "$PRE_MODEL_FILE"
    echo "[axi-game-on] saved previous brain: '${PREV_MODEL:-<none>}' -> $PRE_MODEL_FILE"
fi

# In relocate mode: swap to the game co-pilot brain (qwen35-2b).
# The CPU drop-in below ensures it loads with ngl=0 / CUDA hidden.
if [ "$OFFLINE" -eq 0 ]; then
    echo "[axi-game-on] swapping brain to qwen35-2b (game co-pilot, ~2.2 GB RAM)…"
    if ! "$AXI_PYTHON" -m axi.models_manager set-active qwen35-2b; then
        echo "[axi-game-on] ERROR: set-active qwen35-2b failed — aborting game-on." >&2
        # Restore the backup file since we are not entering game mode.
        rm -f "$PRE_MODEL_FILE"
        exit 1
    fi
fi

# Marker records the active sub-mode so axi-game-off (and the tray/status)
# can tell relocate from offline.
if [ "$OFFLINE" -eq 1 ]; then echo "offline" > "$MARKER"; else echo "relocate" > "$MARKER"; fi

write_dropin() {
    # write_dropin <unit> <conf-body>
    local unit="$1" body="$2" dir="$UNIT_DIR/$1.service.d"
    mkdir -p "$dir"
    printf '%s\n' "$body" > "$dir/game-cpu.conf"
}

echo "[axi-game-on] writing CPU drop-ins (persist across reboot)…"

# Whisper: faster-whisper honours AXI_WHISPER_DEVICE; int8 is the CPU default.
write_dropin axi-whisper "[Service]
Environment=AXI_WHISPER_DEVICE=cpu
Environment=AXI_WHISPER_COMPUTE_TYPE=int8"

# llama-server: clear the GPU ExecStart and re-point it at the --cpu launcher
# (forces -ngl 0). Leading empty ExecStart= is required to override.
# CUDA_VISIBLE_DEVICES= hides the GPU entirely so the CUDA-built llama-server
# does NOT create a ~150 MiB CUDA context — true 0 VRAM, not just 0 layers.
# In co-pilot mode active_model.json now points at gemma4-e2b-it (~2.5 GB file,
# ~4.6 GB RAM at ngl=0), so VRAM usage is effectively 0.
write_dropin llama-server "[Service]
Environment=CUDA_VISIBLE_DEVICES=
ExecStart=
ExecStart=%h/LifeOS/lifeos/axi/scripts/axi-llama-launch --cpu"

# translate: already CPU by default, but pin it so a cuda override also relocates.
write_dropin axi-translate "[Service]
Environment=AXI_OPUS_DEVICE=cpu
Environment=AXI_NLLB_DEVICE=cpu"

systemctl --user daemon-reload

# Restart whisper now: it is the always-on shared server and the current VRAM
# holder, so it must reload on CPU immediately to free the 2.3 GB.
echo "[axi-game-on] relocating axi-whisper to CPU…"
systemctl --user restart axi-whisper.service 2>/dev/null || true

# translate: relocate only if currently active (interpreter mode on demand).
systemctl --user try-restart axi-translate.service 2>/dev/null || true

if [ "$OFFLINE" -eq 1 ]; then
    echo "[axi-game-on] --offline: co-pilot disabled — stopping llama-server (0 CPU for LLM)…"
    systemctl --user stop llama-server.service 2>/dev/null || true
else
    # Restart with the co-pilot brain (gemma4-e2b-it) on CPU.
    # try-restart: only if already running (don't force it on for the first time).
    echo "[axi-game-on] loading qwen35-2b co-pilot on CPU (if llama-server was active)…"
    systemctl --user try-restart llama-server.service 2>/dev/null || true
fi

# VibeThinker-3B (GPU-resident reasoning sibling) has no game-mode role.
# Mask it (reboot-safe) and stop it immediately to free its VRAM.
# game-off will unmask and restart it ONLY if the restored primary == qwen35-4b.
#
# MEETING-SAFE DEFENSIVE GUARD: llama-vt.service may not yet be installed into
# ~/.config/systemd/user/ (the unit file exists in axi/systemd/ but may not be
# symlinked). All operations are skipped silently if the unit is not found.
if systemctl --user list-unit-files llama-vt.service 2>/dev/null | grep -q "llama-vt.service"; then
    echo "[axi-game-on] masking llama-vt.service (VibeThinker-3B — reboot-safe VRAM eviction)…"
    systemctl --user mask llama-vt.service 2>/dev/null || true
    echo "[axi-game-on] stopping llama-vt.service…"
    systemctl --user stop llama-vt.service 2>/dev/null || true
else
    echo "[axi-game-on] llama-vt.service not installed — skipping VT eviction (safe, no-op)."
fi

# axi-voice: enable the always-listening wake-word co-pilot by writing a drop-in
# that sets AXI_WAKEWORD_ENABLED=1, then restart the daemon so it picks it up.
write_dropin axi-voice "[Service]
Environment=AXI_WAKEWORD_ENABLED=1"

echo "[axi-game-on] enabling wake-word listener (AXI_WAKEWORD_ENABLED=1) and restarting axi-voice…"
# daemon-reload AFTER writing the wake-word drop-in: the earlier reload (above) ran
# before this drop-in existed, so without this systemd restarts axi-voice with a stale
# empty environment and the listener never starts.
systemctl --user daemon-reload
systemctl --user restart axi-voice.service 2>/dev/null || true

sleep 1
if command -v nvidia-smi >/dev/null 2>&1; then
    USED=$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits)
    TOTAL=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits)
    echo "[axi-game-on] GPU VRAM: ${USED} / ${TOTAL} MiB usado"
fi

if [ "$OFFLINE" -eq 1 ]; then
    echo "[axi-game-on] MODO JUEGO (offline) activo — co-pilot disabled, VRAM libre."
else
    echo "[axi-game-on] MODO JUEGO (co-pilot) activo — qwen35-2b en CPU (~2.2 GB RAM), VRAM libre."
fi
echo "  Persiste tras reiniciar/apagar: nada se carga en VRAM hasta 'axi-game-off'."
echo "  Para volver a GPU:  axi-game-off"
