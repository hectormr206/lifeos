#!/usr/bin/env bash
# Game Mode (CPU relocate) — free ALL GPU VRAM for demanding games WITHOUT
# taking axi offline. Every axi service that would otherwise hold a CUDA
# context is relocated to CPU + RAM via persistent systemd drop-ins, so the
# feature keeps working (voice, brain, interpreter) — just slower.
#
# Why drop-ins instead of `stop`: the drop-in files under
# ~/.config/systemd/user/<svc>.service.d/ PERSIST across reboot/shutdown.
# If you leave game mode active and reboot, systemd starts each service
# already pinned to CPU, so NOTHING loads into VRAM until `axi-game-off`
# removes the drop-ins. The game-mode.lock marker is the on/off source of
# truth; the drop-ins do the actual relocation.
#
# Usage:
#   axi-game-on             # relocate everything to CPU/RAM (axi stays online)
#   axi-game-on --offline   # legacy max-FPS mode: also STOP the heavy LLM so
#                           # zero CPU is spent on it during the game. Whisper
#                           # and translate still relocate to CPU. The LLM is
#                           # restored (on GPU) by axi-game-off.
#
# VRAM holders on the RTX 5070 Ti (12 GB) and where they go in CPU mode:
#   axi-whisper  (Whisper large-v3-turbo): ~2.3 GB VRAM  -> RAM (int8, CPU)
#   llama-server (Qwen3.6-35B-A3B):        ~GPU layers    -> RAM (-ngl 0)
#   axi-translate (Opus/NLLB):             already CPU by default
#   Result: ~0 MiB VRAM used by axi (effectively all 12 GB free for the game).

set -u

OFFLINE=0
[ "${1:-}" = "--offline" ] && OFFLINE=1

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/axi"
MARKER="$STATE_DIR/game-mode.lock"
UNIT_DIR="$HOME/.config/systemd/user"
mkdir -p "$STATE_DIR"

# Marker records the active sub-mode so axi-game-off (and the tray/status)
# can tell relocate from offline.
if [ "$OFFLINE" -eq 1 ]; then echo "offline" > "$MARKER"; else echo "relocate" > "$MARKER"; fi

write_dropin() {
    # write_dropin <unit> <conf-body>
    local unit="$1" body="$2" dir="$UNIT_DIR/$1.service.d"
    mkdir -p "$dir"
    printf '%s\n' "$body" > "$dir/game-cpu.conf"
}

echo "[axi-game-on] writing CPU drop-ins (persist across reboot)…"

# Whisper: faster-whisper honours AXI_WHISPER_DEVICE; int8 is the CPU default.
write_dropin axi-whisper "[Service]
Environment=AXI_WHISPER_DEVICE=cpu
Environment=AXI_WHISPER_COMPUTE_TYPE=int8"

# llama-server: clear the GPU ExecStart and re-point it at the --cpu launcher
# (forces -ngl 0). Leading empty ExecStart= is required to override.
# CUDA_VISIBLE_DEVICES= hides the GPU entirely so the CUDA-built llama-server
# does NOT create a ~150 MiB CUDA context — true 0 VRAM, not just 0 layers.
write_dropin llama-server "[Service]
Environment=CUDA_VISIBLE_DEVICES=
ExecStart=
ExecStart=%h/LifeOS/lifeos/axi/scripts/axi-llama-launch --cpu"

# translate: already CPU by default, but pin it so a cuda override also relocates.
write_dropin axi-translate "[Service]
Environment=AXI_OPUS_DEVICE=cpu
Environment=AXI_NLLB_DEVICE=cpu"

systemctl --user daemon-reload

# Restart whisper now: it is the always-on shared server and the current VRAM
# holder, so it must reload on CPU immediately to free the 2.3 GB.
echo "[axi-game-on] relocating axi-whisper to CPU…"
systemctl --user restart axi-whisper.service 2>/dev/null || true

# translate: relocate only if currently active (interpreter mode on demand).
systemctl --user try-restart axi-translate.service 2>/dev/null || true

if [ "$OFFLINE" -eq 1 ]; then
    echo "[axi-game-on] --offline: stopping llama-server (LLM uses 0 CPU during game)…"
    systemctl --user stop llama-server.service 2>/dev/null || true
else
    # relocate the brain to CPU only if it is already running; do not force the
    # 22 GB model on if the user did not have it loaded.
    echo "[axi-game-on] relocating llama-server to CPU (if active)…"
    systemctl --user try-restart llama-server.service 2>/dev/null || true
fi

# axi-voice is the daemon (voice + meetings) — it is a Whisper CLIENT, holds NO
# VRAM, and must stay online so meetings/commands keep working in game mode.
# `start` is idempotent; this also self-heals if a legacy game-on stopped it.
echo "[axi-game-on] ensuring axi-voice daemon is online (CPU, no VRAM)…"
systemctl --user start axi-voice.service 2>/dev/null || true

sleep 1
if command -v nvidia-smi >/dev/null 2>&1; then
    USED=$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits)
    TOTAL=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits)
    echo "[axi-game-on] GPU VRAM: ${USED} / ${TOTAL} MiB usado"
fi

if [ "$OFFLINE" -eq 1 ]; then
    echo "[axi-game-on] MODO JUEGO (offline LLM) activo — VRAM libre, brain detenido."
else
    echo "[axi-game-on] MODO JUEGO (CPU) activo — VRAM libre, axi sigue ONLINE en CPU."
fi
echo "  Persiste tras reiniciar/apagar: nada se carga en VRAM hasta 'axi-game-off'."
echo "  Para volver a GPU:  axi-game-off"
