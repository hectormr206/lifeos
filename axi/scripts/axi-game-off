#!/usr/bin/env bash
# Restore the GPU-backed axi stack after a gaming session.
# Removes the CPU drop-ins written by axi-game-on, restores the original brain
# (saved in $STATE_DIR/game-pre-model by axi-game-on), and restarts services
# on GPU.

set -u

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/axi"
MARKER="$STATE_DIR/game-mode.lock"
PRE_MODEL_FILE="$STATE_DIR/game-pre-model"
UNIT_DIR="$HOME/.config/systemd/user"
# Python interpreter used by axi scripts.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
AXI_PYTHON="$SCRIPT_DIR/../.venv/bin/python"
rm -f "$MARKER"

# Initialize PREV_MODEL so it is always defined (even if PRE_MODEL_FILE is absent).
PREV_MODEL=""

echo "[axi-game-off] removing CPU drop-ins…"
# Current drop-ins written by axi-game-on.
rm -f "$UNIT_DIR/axi-whisper.service.d/game-cpu.conf"
rm -f "$UNIT_DIR/llama-server.service.d/game-cpu.conf"
rm -f "$UNIT_DIR/llama-vt.service.d/game-cpu.conf"
rm -f "$UNIT_DIR/axi-translate.service.d/game-cpu.conf"
rm -f "$UNIT_DIR/axi-voice.service.d/game-cpu.conf"
# Legacy drop-in names from earlier versions of these scripts.
rm -f "$UNIT_DIR/llama-server.service.d/cpu-exec.conf"
rm -f "$UNIT_DIR/llama-server.service.d/cpu-override.conf"
rm -f "$UNIT_DIR/axi-voice.service.d/cpu-env.conf"
# Drop empty *.service.d dirs (ignore non-empty, e.g. translate.service.d may
# hold unrelated user drop-ins).
rmdir "$UNIT_DIR/axi-whisper.service.d" 2>/dev/null || true
rmdir "$UNIT_DIR/llama-server.service.d" 2>/dev/null || true
rmdir "$UNIT_DIR/llama-vt.service.d" 2>/dev/null || true
rmdir "$UNIT_DIR/axi-translate.service.d" 2>/dev/null || true
rmdir "$UNIT_DIR/axi-voice.service.d" 2>/dev/null || true

systemctl --user daemon-reload

# Restore the original brain before restarting llama-server.
if [ -f "$PRE_MODEL_FILE" ]; then
    PREV_MODEL=$(cat "$PRE_MODEL_FILE")
    if [ -n "$PREV_MODEL" ]; then
        echo "[axi-game-off] restoring brain: '$PREV_MODEL'…"
        if "$AXI_PYTHON" -m axi.models_manager set-active "$PREV_MODEL"; then
            rm -f "$PRE_MODEL_FILE"
        else
            echo "[axi-game-off] WARNING: set-active '$PREV_MODEL' failed — active_model.json unchanged." >&2
            echo "  You may need to run: $AXI_PYTHON -m axi.models_manager set-active <id>" >&2
        fi
    else
        # Backup was empty (no active model before game-on); leave as-is.
        echo "[axi-game-off] no previous brain recorded — leaving active_model.json unchanged."
        rm -f "$PRE_MODEL_FILE"
    fi
else
    echo "[axi-game-off] NOTE: game-pre-model not found — active_model.json not changed (fallback)."
fi

# Use restart (not start): in relocate mode llama-server stays RUNNING on CPU,
# so `start` would be a no-op and the process would keep its -ngl 0 /
# CUDA_VISIBLE_DEVICES= config. restart forces it to re-exec on GPU now that
# the drop-in is gone and active_model.json is restored.
echo "[axi-game-off] restarting llama-server (restored brain → GPU)…"
systemctl --user restart llama-server.service || true

echo "[axi-game-off] waiting for llama-server /health…"
for i in $(seq 1 30); do
    if curl -sf http://127.0.0.1:8080/health >/dev/null 2>&1; then
        echo "[axi-game-off] llama-server ready"
        break
    fi
    sleep 1
done

# Restore the VibeThinker-3B reasoning sibling ONLY when the restored primary
# is qwen35-4b (the triad brain). For any other primary (35B, 2B, etc.) leaving
# llama-vt stopped is correct: the 35B fills VRAM and VT must NOT start
# (VRAM conflict / mutual-exclusion guard).
#
# MEETING-SAFE DEFENSIVE GUARD: llama-vt.service may not yet be installed into
# ~/.config/systemd/user/ (the unit file exists in axi/systemd/ but may not be
# symlinked). All operations are skipped silently if the unit is not found.
if systemctl --user list-unit-files llama-vt.service 2>/dev/null | grep -q "llama-vt.service"; then
    # Unmask in case an older game-on masked it (previous VRAM-eviction behavior).
    systemctl --user unmask llama-vt.service 2>/dev/null || true
    if [ "${PREV_MODEL:-}" = "qwen35-4b" ]; then
        echo "[axi-game-off] restoring VibeThinker-3B sibling to GPU (primary is qwen35-4b)…"
        # restart (not start): VT may still be RUNNING on CPU from game-on's
        # relocate; the game-cpu drop-in is now removed, so it re-execs on GPU.
        systemctl --user restart llama-vt.service 2>/dev/null || true
        echo "[axi-game-off] waiting for llama-vt /health (8082)…"
        for i in $(seq 1 30); do
            if curl -sf http://127.0.0.1:8082/health >/dev/null 2>&1; then
                echo "[axi-game-off] llama-vt ready"; break
            fi
            sleep 1
        done
    else
        # Primary is the big 35B (or other) — VT cannot share VRAM, so STOP it
        # (it may be running on CPU from game-on's relocate). VRAM guard.
        echo "[axi-game-off] primary is '${PREV_MODEL:-<none>}' (not qwen35-4b) — stopping llama-vt (VRAM guard)."
        systemctl --user stop llama-vt.service 2>/dev/null || true
    fi
else
    echo "[axi-game-off] llama-vt.service not installed — skipping VT restore (safe, no-op)."
fi

echo "[axi-game-off] restarting axi-whisper (Whisper → GPU)…"
systemctl --user restart axi-whisper.service || true

# Restart axi-voice so it picks up the removal of AXI_WAKEWORD_ENABLED=1
# (written as a drop-in by axi-game-on). After restart, the daemon returns to
# hotkey-only mode; the always-listening wake-word listener is stopped.
echo "[axi-game-off] restarting axi-voice (disabling wake-word listener)…"
systemctl --user restart axi-voice.service 2>/dev/null || true

# Restore interpreter mode only if it was running.
systemctl --user try-restart axi-translate.service 2>/dev/null || true

if command -v nvidia-smi >/dev/null 2>&1; then
    sleep 2
    USED=$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits)
    TOTAL=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits)
    echo "[axi-game-off] GPU VRAM: ${USED} / ${TOTAL} MiB usado"
fi

echo "[axi-game-off] axi restaurado en GPU."
