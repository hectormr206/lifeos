#!/usr/bin/env bash
# Deactivate interpreter mode.
#
# Since voice and translate now coexist via the shared axi-whisper.service,
# this just stops translate. axi-voice keeps running and axi-whisper stays
# loaded so a future translate restart is fast.

set -u

echo "[axi-translate-off] stopping axi-translate…"
systemctl --user stop axi-translate.service || true

echo "[axi-translate-off] sistema normal."
