#!/usr/bin/env bash
# Post-system-update health check for the full Axi + LifeOS stack.
#
# Purpose: CachyOS updates roll continuously. After every reboot from a
# kernel/llama.cpp/NVIDIA driver update, run this to know in 30s whether
# anything broke. Returns exit 0 only when EVERYTHING is healthy.
#
# What it checks (in order, fail-fast where it matters):
#   1. systemd --user services that the stack depends on
#   2. GPU + NVIDIA driver responding (nvidia-smi works)
#   3. llama-server /health (the brain is up)
#   4. brain.ask text round-trip (basic inference path)
#   5. brain.ask multimodal round-trip (the FRAGILE path — uses mmproj)
#   6. axi-whisper RPC (Whisper server reachable)
#   7. LifeOS REST endpoints (insights + posture status — fast smoke)
#   8. lifeos test suite (281 tests, ~7s)
#   9. notify-send works (OS notifications dispatch path)
#
# Designed to be safe to run anytime — only does GETs + one tiny brain
# call. No mutations, no test data leftovers.

set -u
cd "$HOME/LifeOS/lifeos/axi"

PY="$HOME/LifeOS/lifeos/axi/.venv/bin/python"
DASHBOARD="https://127.0.0.1:8081"
LLAMA="http://127.0.0.1:8080"

GREEN=$'\033[32m'
RED=$'\033[31m'
YELLOW=$'\033[33m'
DIM=$'\033[2m'
RESET=$'\033[0m'

pass() { printf "%s✓%s %s\n" "$GREEN" "$RESET" "$1"; }
fail() { printf "%s✗%s %s %s%s%s\n" "$RED" "$RESET" "$1" "$DIM" "$2" "$RESET"; }
warn() { printf "%s⚠%s %s %s%s%s\n" "$YELLOW" "$RESET" "$1" "$DIM" "$2" "$RESET"; }
step() { printf "\n%s[%s/9] %s%s\n" "$DIM" "$1" "$2" "$RESET"; }

OVERALL=0

# ─── 1. systemd services ──────────────────────────────────────────────
step 1 "systemd services"
for svc in llama-server axi-whisper axi-voice axi-dashboard; do
    state=$(systemctl --user is-active "$svc" 2>&1)
    if [ "$state" = "active" ]; then
        pass "$svc"
    else
        fail "$svc" "estado: $state"
        OVERALL=1
    fi
done

# ─── 2. GPU + NVIDIA driver ───────────────────────────────────────────
step 2 "GPU / NVIDIA driver"
if nvidia-smi --query-gpu=name,memory.used,memory.total --format=csv,noheader 2>&1 | head -1; then
    pass "nvidia-smi responde"
else
    fail "nvidia-smi" "driver no carga — el kernel pudo haber roto el módulo"
    OVERALL=1
fi

# ─── 3. llama-server health ───────────────────────────────────────────
step 3 "llama-server /health"
health=$(curl -sf -m 5 "$LLAMA/health" 2>&1)
if printf "%s" "$health" | grep -q '"ok"'; then
    pass "llama-server arriba"
    model=$(curl -sf -m 5 "$LLAMA/v1/models" 2>&1 | "$PY" -c "import json,sys; d=json.load(sys.stdin); print(d['models'][0]['name'])" 2>/dev/null)
    [ -n "$model" ] && printf "  %smodelo activo: %s%s\n" "$DIM" "$model" "$RESET"
else
    fail "llama-server" "respuesta: $health"
    OVERALL=1
fi

# ─── 4. brain.ask text round-trip ─────────────────────────────────────
step 4 "brain.ask (text)"
ans=$("$PY" -c "
import sys
try:
    from axi import brain
    r = brain.ask('Dime hola en una palabra.', max_tokens=50)
    print(r[:80])
except Exception as e:
    print(f'EXC {type(e).__name__}: {e}', file=sys.stderr)
    sys.exit(1)
" 2>&1)
if [ $? -eq 0 ] && [ -n "$ans" ]; then
    pass "brain text"
    printf "  %srespuesta: %s%s\n" "$DIM" "${ans:0:80}" "$RESET"
else
    fail "brain text" "$ans"
    OVERALL=1
fi

# ─── 5. brain.ask multimodal round-trip ───────────────────────────────
step 5 "brain.ask (multimodal — vision/mmproj)"
ans=$("$PY" -c "
import base64, sys
# 1x1 black PNG (minimal valid image)
PNG_1X1 = base64.b64decode(
    'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII='
)
b64 = base64.b64encode(PNG_1X1).decode('ascii')
try:
    from axi import brain
    r = brain.ask('Describe la imagen en 5 palabras.', image_b64=b64, max_tokens=50)
    print(r[:120])
except Exception as e:
    print(f'EXC {type(e).__name__}: {e}', file=sys.stderr)
    sys.exit(1)
" 2>&1)
if [ $? -eq 0 ] && [ -n "$ans" ]; then
    pass "brain multimodal (vision pipeline OK)"
    printf "  %srespuesta: %s%s\n" "$DIM" "${ans:0:120}" "$RESET"
else
    fail "brain multimodal" "$ans (mmproj / vision puede haberse roto con la nueva llama.cpp)"
    OVERALL=1
fi

# ─── 6. axi-whisper RPC ───────────────────────────────────────────────
step 6 "axi-whisper RPC"
WHISPER_SOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/axi/whisper.sock"
if [ -S "$WHISPER_SOCK" ]; then
    pass "axi-whisper socket existe ($WHISPER_SOCK)"
else
    if systemctl --user is-active --quiet axi-whisper; then
        warn "axi-whisper" "service activo pero socket no en $WHISPER_SOCK (revisar logs)"
    else
        fail "axi-whisper" "service no activo"
        OVERALL=1
    fi
fi

# ─── 7. LifeOS REST smoke ─────────────────────────────────────────────
step 7 "LifeOS REST endpoints"
all_endpoints_ok=1
for ep in "/api/reminders?status=pending" "/api/health/entries?days=1" \
          "/api/finance/summary?days=30" "/api/insights/preview?cadence=daily" \
          "/api/posture/status"; do
    code=$(curl -sk -o /dev/null -m 5 -w '%{http_code}' "$DASHBOARD$ep")
    if [ "$code" = "200" ]; then
        printf "  %s✓%s %s\n" "$GREEN" "$RESET" "$ep"
    else
        printf "  %s✗%s %s (HTTP %s)\n" "$RED" "$RESET" "$ep" "$code"
        all_endpoints_ok=0
    fi
done
if [ "$all_endpoints_ok" -eq 1 ]; then
    pass "todos los endpoints LifeOS OK"
else
    fail "LifeOS endpoints" "alguno respondió != 200"
    OVERALL=1
fi

# ─── 8. lifeos pytest suite ───────────────────────────────────────────
step 8 "lifeos tests (281 ~ 7s)"
out=$("$PY" -m pytest ../lifeos/tests/ -q --no-header --tb=no 2>&1 | tail -3)
if printf "%s" "$out" | grep -qE "passed"; then
    summary=$(printf "%s" "$out" | tail -1)
    pass "tests verde"
    printf "  %s%s%s\n" "$DIM" "$summary" "$RESET"
else
    fail "tests" "$(printf "%s" "$out" | tail -3)"
    OVERALL=1
fi

# ─── 9. notify-send (OS notification path) ────────────────────────────
step 9 "notify-send (OS push path)"
if command -v notify-send >/dev/null 2>&1; then
    pass "notify-send disponible"
else
    fail "notify-send" "no instalado — OS notifications no van a llegar"
    OVERALL=1
fi

# ─── Summary ──────────────────────────────────────────────────────────
echo
if [ "$OVERALL" -eq 0 ]; then
    printf "%sTODO OK ✓%s — Axi + LifeOS sobrevivieron el update.\n" "$GREEN" "$RESET"
else
    printf "%sFALLAS DETECTADAS ✗%s — leé arriba qué rompió.\n" "$RED" "$RESET"
    printf "%sSi es multimodal/vision (paso 5): probable issue con la nueva llama.cpp.\n" "$DIM"
    printf "%sRollback opcional: sudo snapper -c root rollback <num>%s\n" "$DIM" "$RESET"
fi
exit "$OVERALL"
